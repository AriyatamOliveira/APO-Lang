# Set duration to 0 for endless animation. Default demo lasts 10 seconds.
duration = 10
start = clock()
print: "\e[2J"
while duration = 0 or clock() - start < duration do
  elapsed = clock() - start
  tick = int(floor(elapsed * 20))
  frame = tick % 64i
  print: "\e[HAPO 1.5 | TIMED SPINNING DONUT", \nl
  print: donut_frame(frame), \nl
  print: "20 FPS target | Time-based rotation | Ctrl+C to stop", \nl
  # Absolute deadlines avoid cumulative drift. Missed frames are skipped.
  sleep_until(start + number(tick + 1i) * 0.05)
end
print: \nl
