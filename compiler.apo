  if name = "pokefloat" then
    return "V!PF"
  end
  return ""
end
# Type IDs: number=0 string=1 bool=2 int=3 buffer=4 pointer=5 void=6 float=7.
fn typecode(name: string, allow_void: bool): int
  if name = "number" or name = "num" then
    return 0i
  end
  if name = "string" then
    return 1i
  end
  if name = "bool" then
    return 2i
  end
  if name = "int" then
    return 3i
  end
  if name = "buffer" then
    return 4i
  end
  if name = "pointer" or name = "ptr" then
    return 5i
  end
  if name = "void" and allow_void then
    return 6i
  end
  if name = "float" or name = "f64" then
    return 7i
  end
  return -1i
end
fn read_type(p: pointer, allow_void: bool): int
  t = expect(p, 2i, "expected a type name")
  code = typecode(gets(t, 1i), allow_void)
  if code < 0i then
    fail(p, t, "unknown or disallowed type")
  end
  return code
end
fn numeric(t: int): bool
  return t = 0i or t = 3i or t = 7i
end
fn push_scope(p: pointer): void
  scope = arena(p, 32i)
  putp(scope, 1i, getp(p, 6i))
  putp(p, 6i, scope)
end
fn pop_scope(p: pointer): void
  putp(p, 6i, getp(getp(p, 6i), 1i))
end
fn binding(p: pointer, name: string): pointer
  scope = getp(p, 6i)
  while scope != nil() do
    item = getp(scope, 0i)
    while item != nil() do
      if gets(item, 0i) = name then
        return item
      end
      item = getp(item, 4i)
    end
    scope = getp(scope, 1i)
  end
  return nil()
end
fn bind_name(p: pointer, name: string, datatype: int, slot: int): void
  scope = getp(p, 6i)
  item = arena(p, 64i)
  puts(item, 0i, name)
  put(item, 2i, datatype)
  put(item, 3i, slot)
  putp(item, 4i, getp(scope, 0i))
  putp(scope, 0i, item)
end
fn slots(p: pointer, count: int, t: pointer): int
  start = get(p, 7i)
  if count < 0i or count > 2048i - start then
    fail(p, t, "stack frame exceeds 2048 local slots")
  end
  put(p, 7i, start + count)
  return start
end
fn name_bucket(name: string): int
  h = 0i
  i = 0i
  while i < int(len(name)) do
    h = band(h * 33i + byte_at(name, i), 1023i)
    i = i + 1i
  end
  return h
end
fn function_named(p: pointer, name: string): pointer
  f = getp(getp(p, 26i), name_bucket(name))
  while f != nil() do
    if gets(f, 0i) = name then
      return f
    end
    f = getp(f, 10i)
  end
  return nil()
end
fn leaf(p: pointer, k: int, datatype: int, tok: pointer): pointer
  e = arena(p, 128i)
  put(e, 0i, k)
  put(e, 1i, datatype)
  putp(e, 2i, tok)
  puts(e, 4i, gets(tok, 1i))
  put(e, 11i, 1i)
  return e
end
fn remember(p: pointer, e: pointer): pointer
  depth = 1i
  if getp(e, 7i) != nil() then
    depth = maxint(depth, get(getp(e, 7i), 11i) + 1i)
  end
  if getp(e, 8i) != nil() then
    depth = maxint(depth, get(getp(e, 8i), 11i) + 1i)
  end
  list = getp(e, 9i)
  if list != nil() then
    item = getp(list, 0i)
    while item != nil() do
      depth = maxint(depth, get(getp(item, 0i), 11i) + 1i)
      item = getp(item, 1i)
    end
  end
  if depth > 128i then
    fail(p, getp(e, 2i), "expression tree exceeds depth 128")
  end
  put(e, 11i, depth)
  return e
end
fn require_type(p: pointer, e: pointer, datatype: int): void
  if get(e, 1i) != datatype then
    fail(p, getp(e, 2i), "type mismatch (conversions must be explicit)")
  end
end
fn literal(p: pointer, tok: pointer, negative: bool): pointer
  text = gets(tok, 1i)
  n = int(len(text))
  if get(tok, 0i) = 46i then
    v = float(0)
    divisor = float(1)
    fractional = false
    i = 0i
    digits = 0i
    while i < n - 1i do
      ch = byte_at(text, i)
      if ch = 46i then
        fractional = true
      else
        digits = digits + 1i
        if digits > 17i then
          fail(p, tok, "float literal exceeds 17 digits; use explicit arithmetic")
        end
        v = v * float(10) + float(ch - 48i)
        if fractional then
          divisor = divisor * float(10)
        end
      end
      i = i + 1i
    end
    v = v / divisor
    if negative then
      v = -v
    end
    e = leaf(p, 0i, 7i, tok)
    put(e, 3i, float_bits(v))
    return e
  end
  isint = get(tok, 0i) = 17i
  result_type = 0i
  if isint then
    result_type = 3i
  end
  e = leaf(p, 0i, result_type, tok)
  if starts(text, "0x") or starts(text, "0X") then
    v = 0i
    i = 2i
    while i < n do
      digit = hexval(byte_at(text, i))
      if digit < 0i or shr(v, 60i) != 0i then
        fail(p, tok, "hex literal exceeds 64 bits")
      end
      v = bor(shl(v, 4i), digit)
      i = i + 1i
    end
    if negative then
      if v < 0i then
        fail(p, tok, "cannot negate a high-bit hex literal")
      end
      v = -v
    end
    put(e, 3i, v)
    return e
  end
  if isint then
    n = n - 1i
  end
  # Accumulate negatively: INT64_MIN is representable without overflowing.
  limit = -9223372036854775807i
  if negative then
    limit = -9223372036854775808i
  end
  q = limit / 10i
  last = -(limit % 10i)
  v = 0i
  frac = -1i
  i = 0i
  while i < n do
    ch = byte_at(text, i)
    i = i + 1i
    if ch = 46i then
      frac = 0i
      continue
    end
    d = ch - 48i
    if d < 0i or d > 9i then
      fail(p, tok, "invalid number literal")
    end
    if v < q or (v = q and d > last) then
      fail(p, tok, "numeric literal out of range")
    end
    v = v * 10i - d
    if frac >= 0i then
      frac = frac + 1i
      if frac > 6i then
        fail(p, tok, "number literals allow at most 6 decimal places")
      end
    end
  end
  if not isint then
    if frac < 0i then
      frac = 0i
    end
    while frac < 6i do
      if v < q then
        fail(p, tok, "numeric literal out of range")
      end
      v = v * 10i
      frac = frac + 1i
    end
  end
  if not negative then
    v = -v
  end
  put(e, 3i, v)
  return e
end
fn class_matches(code: int, datatype: int): bool
  if code = 78i then
    return datatype = 0i
  end
  if code = 83i then
    return datatype = 1i
  end
  if code = 79i then
    return datatype = 2i
  end
  if code = 73i then
    return datatype = 3i
  end
  if code = 66i then
    return datatype = 4i
  end
  if code = 80i then
    return datatype = 5i
  end
  if code = 70i then
    return datatype = 7i
  end
  if code = 82i then
    return datatype = 0i or datatype = 3i
  end
  if code = 84i then
    return datatype = 1i or datatype = 4i
  end
  if code = 81i then
    return datatype = 3i or datatype = 5i
  end
  if code = 67i then
    return numeric(datatype)
  end
  if code = 68i then
    return datatype = 0i or datatype = 7i
  end
  return false
end
fn signature_result(code: int): int
  if code = 78i then
    return 0i
  end
  if code = 83i then
    return 1i
  end
  if code = 79i then
    return 2i
  end
  if code = 73i then
    return 3i
  end
  if code = 66i then
    return 4i
  end
  if code = 80i then
    return 5i
  end
  if code = 86i then
    return 6i
  end
  if code = 70i then
    return 7i
  end
  return -1i
end
fn task_builtin_allowed(name: string): bool
  if starts(name, "load") or starts(name, "store") or starts(name, "peek") or starts(name, "poke") or starts(name, "atomic_") then
    return true
  end
  for allowed in "int" "number" "float" "float_bits" "float_from_bits" "float32_bits" "float32_from_bits" "sqrt" "trunc" "floor" "ceil" "abs" "len" "char_at" "byte_at" "slice" "view" "string_at" "copy" "fill" "fill32" "fill64" "fill_range" "fill32_range" "fill64_range" "address" "pointer" "address_int" "offset" "band" "bor" "bxor" "bnot" "shl" "shr" "sar" "assert" "asm32"
    if name = allowed then
      return true
    end
  end
  return false
end

fn call_node(p: pointer, tok: pointer, name: string, args: pointer, count: int): pointer
  e = leaf(p, 6i, 6i, tok)
  puts(e, 4i, name)
  putp(e, 9i, args)
  put(e, 10i, count)
  spec = builtin_spec(name)
  if spec != "" then
    if get(p, 27i) != 0i and not task_builtin_allowed(name) then
      fail(p, tok, concat("operation is not permitted inside a task: ", name))
    end
    if byte_at(spec, 1i) = 33i and get(p, 13i) = 0i then
      fail(p, tok, "this operation requires unsafe ... end")
    end
    if byte_at(spec, 1i) = 116i then
      put(p, 12i, 1i)
    end
    if starts(name, "ccall") then
      if count < 1i or count > 16i then
        fail(p, tok, "ccall requires a function pointer and up to 15 arguments")
      end
      require_type(p, list_get(args, 0i), 5i)
      gp = 0i
      fp = 0i
      j = 1i
      while j < count do
        t = get(list_get(args, j), 1i)
        if t = 7i then
          fp = fp + 1i
        else
          if t != 3i and t != 5i then
            fail(p, tok, "C ABI arguments must be int, pointer, or float")
          end
          gp = gp + 1i
        end
        j = j + 1i
      end
      if gp > 8i or fp > 8i then
        fail(p, tok, "ccall supports at most eight integer and eight FP argument registers; no stack arguments")
      end
    else
    if name = "asm32" then
      if count < 1i or count > 7i then
        fail(p, tok, "asm32 requires an opcode and up to six registers")
      end
      op = list_get(args, 0i)
      if get(op, 0i) != 0i or get(op, 1i) != 3i or get(op, 3i) < 0i or get(op, 3i) > 4294967295i then
        fail(p, tok, "asm32 opcode must be a 32-bit integer literal")
      end
      j = 1i
      while j < count do
        t = get(list_get(args, j), 1i)
        if t != 3i and t != 5i then
          fail(p, tok, "asm32 register inputs must be int or pointer")
        end
        j = j + 1i
      end
    else
      if count != int(len(spec)) - 2i then
        fail(p, tok, "wrong number of built-in arguments")
      end
      i = 0i
      while i < count do
        if not class_matches(byte_at(spec, i + 2i), get(list_get(args, i), 1i)) then
          fail(p, tok, "invalid built-in argument type")
        end
        i = i + 1i
      end
    end
    end
    result_type = signature_result(byte_at(spec, 0i))
    if byte_at(spec, 0i) = 88i then
      result_type = get(list_get(args, 0i), 1i)
    end
    need(result_type >= 0i, "internal builtin signature")
    put(e, 1i, result_type)
  else
    f = function_named(p, name)
    if f = nil() then
      fail(p, tok, "unknown function; define it before use")
    end
    if get(p, 27i) != 0i and get(f, 11i) != 1i then
      fail(p, tok, "tasks can call only task functions, not ordinary functions")
    end
    if count != get(f, 5i) then
      fail(p, tok, "wrong number of function arguments")
    end
    i = 0i
    while i < count do
      require_type(p, list_get(args, i), get(list_get(getp(f, 4i), i), 2i))
      i = i + 1i
    end
    putp(e, 12i, f)
    put(e, 1i, get(f, 3i))
  end
  return remember(p, e)
end
fn unary_node(p: pointer, tok: pointer, operand: pointer): pointer
  t = get(operand, 1i)
  if get(tok, 0i) = 38i then
    require_type(p, operand, 2i)
    t = 2i
  else
    if not numeric(t) then
      fail(p, tok, "unary sign requires a numeric value")
    end
  end
  e = leaf(p, 4i, t, tok)
  putp(e, 7i, operand)
  return remember(p, e)
end
fn binary_node(p: pointer, tok: pointer, left: pointer, right: pointer): pointer
  t = get(left, 1i)
  k = get(tok, 0i)
  if k = 36i or k = 37i then
    require_type(p, left, 2i)
    require_type(p, right, 2i)
    t = 2i
  else
    require_type(p, right, t)
    if k = 18i or k = 19i or k = 53i then
      if t = 4i or t = 6i then
        fail(p, tok, "buffer and void values cannot be compared")
      end
      t = 2i
    else
      if not numeric(t) then
        fail(p, tok, "operator requires matching numeric types")
      end
      if k = 16i and t = 7i then
        fail(p, tok, "floating remainder is not supported")
      end
      if k >= 20i and k <= 23i then
        t = 2i
      end
    end
  end
  e = leaf(p, 5i, t, tok)
  if k = 53i then
    puts(e, 4i, "=")
  end
  putp(e, 7i, left)
  putp(e, 8i, right)
  return remember(p, e)
end
fn precedence(k: int): int
  if k = 37i then
    return 10i
  end
  if k = 36i then
    return 20i
  end
  if k = 18i or k = 19i or k = 53i then
    return 40i
  end
  if k >= 20i and k <= 23i then
    return 50i
  end
  if k = 12i or k = 13i then
    return 60i
  end
  if k = 14i or k = 15i or k = 16i then
    return 70i
  end
  return -1i
end
# Pratt expression parser. Recursive calls are bounded independently of AST depth.
fn expression(p: pointer, minimum: int): pointer
  depth = get(p, 16i) + 1i
  if depth > 128i then
    fail(p, peek(p), "expression nesting exceeds 128")
  end
  put(p, 16i, depth)
  tok = take(p)
  k = get(tok, 0i)
  left = nil()
  if k = 3i or k = 17i or k = 46i then
    left = literal(p, tok, false)
  else
    if k = 4i then
      left = leaf(p, 1i, 1i, tok)
    else
      if k = 34i or k = 35i then
        left = leaf(p, 2i, 2i, tok)
        if k = 34i then
          put(left, 3i, 1i)
        end
      else
        if k = 2i then
          if accept(p, 6i) then
            args = nil()
            count = 0i
            if kind(p) != 7i then
              while true do
                if count >= 16i then
                  fail(p, tok, "at most 16 call arguments are supported")
                end
                item = expression(p, 0i)
                args = list_add(p, args, item)
                count = count + 1i
                if not accept(p, 10i) or kind(p) = 7i then
                  break
                end
              end
            end
            expect(p, 7i, "expected ) after arguments")
            left = call_node(p, tok, gets(tok, 1i), args, count)
          else
            b = binding(p, gets(tok, 1i))
            if b = nil() then
              f = function_named(p, gets(tok, 1i))
              if f = nil() or get(f, 11i) != 1i then
                fail(p, tok, concat("undefined variable: ", gets(tok, 1i)))
              end
              left = leaf(p, 7i, 5i, tok)
              putp(left, 12i, f)
            else
              left = leaf(p, 3i, get(b, 2i), tok)
              put(left, 6i, get(b, 3i))
            end
          end
        else
          if k = 6i then
            left = expression(p, 0i)
            expect(p, 7i, "expected closing )")
          else
            if k = 12i or k = 13i or k = 38i then
              if minimum >= 90i and k != 38i and get(tok, 6i) != get(peek(p), 5i) then
                fail(p, tok, "attach a for-list sign to its item; parenthesize expressions")
              end
              if k = 13i and (kind(p) = 3i or kind(p) = 17i or kind(p) = 46i) then
                left = literal(p, take(p), true)
              else
                strength = 80i
                if k = 38i and minimum < 90i then
                  strength = 30i
                end
                if minimum >= 90i then
                  strength = 90i
                end
                left = unary_node(p, tok, expression(p, strength))
              end
            else
              fail(p, tok, "expected an expression")
            end
          end
        end
      end
    end
  end
  while true do
    if accept(p, 8i) then
      t = get(left, 1i)
      if t != 1i and t != 4i then
        fail(p, tok, "only buffers and strings support indexing")
      end
      args = list_add(p, nil(), left)
      args = list_add(p, args, expression(p, 0i))
      expect(p, 9i, "expected closing ]")
      name = "char_at"
      if t = 4i then
        name = "load8"
      end
      left = call_node(p, tok, name, args, 2i)
      continue
    end
    prec = precedence(kind(p))
    if prec < minimum or prec < 0i then
      break
    end
    op = take(p)
    right = expression(p, prec + 1i)
    left = binary_node(p, op, left, right)
  end
  put(p, 16i, depth - 1i)
  return left
end
fn call_arguments(p: pointer, token: pointer): pointer
  args = nil()
  count = 0i
  if kind(p) != 7i then
    while true do
      if count >= 16i then
        fail(p, token, "at most 16 call arguments are supported")
      end
      args = list_add(p, args, expression(p, 0i))
      count = count + 1i
      if not accept(p, 10i) or kind(p) = 7i then
        break
      end
    end
  end
  expect(p, 7i, "expected ) after arguments")
  return call_node(p, token, gets(token, 1i), args, count)
end
fn returns(body: pointer): bool
  s = body
  while s != nil() do
    if get(s, 12i) != 0i then
      return true
    end
    s = getp(s, 11i)
  end
  return false
end
# mode=0 parses a scoped block; mode=1 parses one top-level statement.
fn block(p: pointer, mode: int): pointer
  d = get(p, 17i)
  if mode = 0i then
    if d >= 64i then
      fail(p, peek(p), "block nesting exceeds 64")
    end
    put(p, 17i, d + 1i)
    push_scope(p)
  end
  head = nil()
  tail = nil()
  skip_lines(p)
  while kind(p) != 28i and kind(p) != 27i and kind(p) != 54i and kind(p) != 0i do
    first = take(p)
    k = get(first, 0i)
    declaration = 0i
    if get(p, 27i) != 0i and (k = 24i or k = 55i or k = 33i) then
      fail(p, first, "printing and process exit are not allowed inside tasks")
    end
    if k = 56i then
      first = expect(p, 2i, "expected an existing variable after set")
      k = 2i
      if binding(p, gets(first, 1i)) = nil() then
        fail(p, first, "set requires an existing variable; use let to declare one")
      end
      if kind(p) != 18i and kind(p) != 8i and not (kind(p) >= 47i and kind(p) <= 51i) then
        fail(p, first, "set requires an assignment, without a type annotation")
      end
    end
    if k = 44i or k = 45i then
      declaration = k
      first = expect(p, 2i, "expected variable name after let/const")
      k = 2i
      scope_item = getp(getp(p, 6i), 0i)
      while scope_item != nil() do
        if gets(scope_item, 0i) = gets(first, 1i) then
          fail(p, first, "let/const cannot redeclare a name in the same scope")
        end
        scope_item = getp(scope_item, 4i)
      end
      if kind(p) != 11i and kind(p) != 18i then
        fail(p, first, "let/const requires an initializer")
      end
    end
    s = arena(p, 128i)
    putp(s, 1i, first)
    if k = 2i then
      if accept(p, 6i) then
        put(s, 0i, 6i)
        putp(s, 4i, call_arguments(p, first))
      else
        if accept(p, 8i) then
          b = binding(p, gets(first, 1i))
          if b = nil() then
            fail(p, first, "undefined buffer variable")
          end
          if get(b, 2i) != 4i then
            fail(p, first, "indexed assignment requires a buffer")
          end
          base = leaf(p, 3i, 4i, first)
          put(base, 6i, get(b, 3i))
          args = list_add(p, nil(), base)
          args = list_add(p, args, expression(p, 0i))
          expect(p, 9i, "expected ]")
          expect(p, 18i, "expected = after buffer index")
          args = list_add(p, args, expression(p, 0i))
          put(s, 0i, 6i)
          putp(s, 4i, call_node(p, first, "store8", args, 3i))
        else
          annotated = accept(p, 11i)
          requested = -1i
          if annotated then
            requested = read_type(p, false)
          end
          update = nil()
          if kind(p) >= 47i and kind(p) <= 51i then
            if declaration != 0i or annotated then
              fail(p, first, "compound assignment updates an existing, unannotated variable")
            end
            update = take(p)
          else
            expect(p, 18i, "expected = (assignment), not == (comparison)")
          end
          e = expression(p, 0i)
          if update != nil() then
            previous = binding(p, gets(first, 1i))
            if previous = nil() then
              fail(p, first, "compound assignment requires an existing variable")
            end
            left = leaf(p, 3i, get(previous, 2i), first)
            put(left, 6i, get(previous, 3i))
            put(update, 0i, get(update, 0i) - 35i)
            puts(update, 1i, slice(gets(update, 1i), 0i, 1i))
            e = binary_node(p, update, left, e)
          end
          t = get(e, 1i)
          if t = 6i then
            fail(p, first, "cannot assign a void result")
          end
          if annotated and requested != t then
            conversion = ""
            if requested = 3i and t = 0i then
              conversion = "int"
            end
            if requested = 0i and t = 3i then
              conversion = "number"
            end
            if requested = 7i and (t = 0i or t = 3i) then
              conversion = "float"
            end
            if conversion = "" then
              fail(p, first, "initializer does not match its annotation")
            end
            args = list_add(p, nil(), e)
            e = call_node(p, first, conversion, args, 1i)
            t = get(e, 1i)
          end
          b = binding(p, gets(first, 1i))
          if declaration != 0i then
            b = nil()
          end
          slot = 0i
          if b = nil() then
            slot = slots(p, 1i, first)
            bind_name(p, gets(first, 1i), t, slot)
            if declaration = 45i then
              put(binding(p, gets(first, 1i)), 5i, 1i)
            end
          else
            if get(b, 5i) = 1i then
              fail(p, first, "cannot reassign a const binding")
            end
            if get(b, 2i) != t then
              fail(p, first, "a variable cannot change type")
            end
            slot = get(b, 3i)
          end
          put(s, 0i, 0i)
          put(s, 2i, slot)
          put(s, 3i, t)
          putp(s, 4i, e)
        end
      end
    else
      if k = 24i or k = 55i then
        put(s, 0i, 1i)
        accept(p, 11i)
        items = nil()
        count = 0i
        while true do
          if k = 55i and count = 0i and (kind(p) = 1i or kind(p) = 0i) then
            break
          end
          item = nil()
          if kind(p) = 5i then
            item = leaf(p, 1i, 1i, take(p))
          else
            item = expression(p, 0i)
          end
          if get(item, 1i) = 4i or get(item, 1i) = 6i then
            fail(p, first, "cannot print buffers or void values")
          end
          items = list_add(p, items, item)
          count = count + 1i
          if not accept(p, 10i) then
            break
          end
        end
        if k = 55i then
          newline = leaf(p, 1i, 1i, first)
          puts(newline, 4i, "\n")
          items = list_add(p, items, newline)
          count = count + 1i
        end
        putp(s, 5i, items)
        put(s, 6i, count)
      else
        if k = 33i then
          put(s, 0i, 5i)
          accept(p, 11i)
          e = expression(p, 0i)
          if get(e, 1i) != 0i and get(e, 1i) != 3i then
            fail(p, first, "exit needs a number or int")
          end
          putp(s, 4i, e)
          put(s, 12i, 1i)
        else
          if k = 25i then
            put(s, 0i, 2i)
            e = expression(p, 0i)
            require_type(p, e, 2i)
            putp(s, 4i, e)
            expect(p, 26i, "expected then")
            expect(p, 1i, "expected newline after then")
            putp(s, 7i, block(p, 0i))
            branch = s
            chain = nil()
            branches = 0i
            while kind(p) = 54i do
              branch_token = take(p)
              branches = branches + 1i
              if branches > 64i then
                fail(p, branch_token, "elif chain exceeds 64 branches")
              end
              record = arena(p, 16i)
              putp(record, 0i, branch)
              putp(record, 1i, chain)
              chain = record
              child = arena(p, 128i)
              put(child, 0i, 2i)
              putp(child, 1i, branch_token)
              condition = expression(p, 0i)
              require_type(p, condition, 2i)
              putp(child, 4i, condition)
              expect(p, 26i, "expected then after elif condition")
              expect(p, 1i, "expected newline after then")
              putp(child, 7i, block(p, 0i))
              putp(branch, 8i, child)
              branch = child
            end
            if accept(p, 27i) then
              expect(p, 1i, "expected newline after else")
              putp(branch, 8i, block(p, 0i))
            end
            expect(p, 28i, "expected end after if")
            while true do
              if returns(getp(branch, 7i)) and returns(getp(branch, 8i)) then
                put(branch, 12i, 1i)
              end
              if chain = nil() then
                break
              end
              branch = getp(chain, 0i)
              chain = getp(chain, 1i)
            end
          else
            if k = 31i then
              put(s, 0i, 4i)
              e = expression(p, 0i)
              require_type(p, e, 2i)
              putp(s, 4i, e)
              expect(p, 32i, "expected do after while condition")
              expect(p, 1i, "expected newline after do")
              put(p, 14i, get(p, 14i) + 1i)
              putp(s, 7i, block(p, 0i))
              put(p, 14i, get(p, 14i) - 1i)
              expect(p, 28i, "expected end after while")
            else
              if k = 29i then
                put(s, 0i, 3i)
                name = expect(p, 2i, "expected for variable")
                expect(p, 30i, "expected in")
                items = nil()
                count = 0i
                t = -1i
                while kind(p) != 1i and kind(p) != 0i do
                  item = expression(p, 90i)
                  if get(item, 1i) = 6i then
                    fail(p, name, "void item in for list")
                  end
                  if count = 0i then
                    t = get(item, 1i)
                  else
                    require_type(p, item, t)
                  end
                  items = list_add(p, items, item)
                  count = count + 1i
                  if count > 2048i then
                    fail(p, name, "for list is too long")
                  end
                end
                if count = 0i then
                  fail(p, name, "for list must not be empty")
                end
                expect(p, 1i, "expected newline after for list")
                putp(s, 5i, items)
                put(s, 6i, count)
                put(s, 3i, t)
                put(s, 2i, slots(p, 1i, name))
                put(s, 9i, slots(p, 1i, name))
                put(s, 10i, slots(p, count, name))
                push_scope(p)
                bind_name(p, gets(name, 1i), t, get(s, 2i))
                put(p, 14i, get(p, 14i) + 1i)
                putp(s, 7i, block(p, 0i))
                put(p, 14i, get(p, 14i) - 1i)
                pop_scope(p)
                expect(p, 28i, "expected end after for")
              else
                if k = 41i then
                  put(s, 0i, 7i)
                  expect(p, 1i, "expected newline after unsafe")
                  put(p, 13i, get(p, 13i) + 1i)
                  putp(s, 7i, block(p, 0i))
                  put(p, 13i, get(p, 13i) - 1i)
                  expect(p, 28i, "expected end after unsafe")
                  if returns(getp(s, 7i)) then
                    put(s, 12i, 1i)
                  end
                else
                  if k = 40i then
                    put(s, 0i, 8i)
                    result = get(p, 15i)
                    if result < 0i then
                      fail(p, first, "return is only valid in a function")
                    end
                    if kind(p) != 1i and kind(p) != 0i then
                      e = expression(p, 0i)
                      if result = 6i then
                        fail(p, first, "void functions cannot return a value")
                      end
                      require_type(p, e, result)
                      putp(s, 4i, e)
                    else
                      if result != 6i then
                        fail(p, first, "this function must return a value")
                      end
                    end
                    put(s, 12i, 1i)
                  else
                    if k = 42i or k = 43i then
                      if get(p, 14i) = 0i then
                        fail(p, first, "break and continue require a loop")
                      end
                      put(s, 0i, 9i)
                      if k = 43i then
                        put(s, 0i, 10i)
                      end
                    else
                      fail(p, first, "expected a statement; functions are top-level only")
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
    finish_line(p)
    if head = nil() then
      head = s
    else
      putp(tail, 11i, s)
    end
    tail = s
    if mode = 1i then
      break
    end
    skip_lines(p)
  end
  if mode = 0i then
    pop_scope(p)
    put(p, 17i, d)
  end
  return head
end
fn function_definition(p: pointer): void
  tok = expect(p, 2i, "expected function name")
  name = gets(tok, 1i)
  if builtin_spec(name) != "" or function_named(p, name) != nil() then
    fail(p, tok, "function name is already defined or reserved")
  end
  f = arena(p, 128i)
  put(f, 11i, get(p, 27i))
  puts(f, 0i, name)
  putp(f, 2i, tok)
  expect(p, 6i, "expected (")
  params = nil()
  count = 0i
  if kind(p) != 7i then
    while true do
      if count >= 16i then
        fail(p, tok, "at most 16 function parameters are supported")
      end
      arg = expect(p, 2i, "expected parameter name")
      i = 0i
      while i < count do
        if gets(list_get(params, i), 0i) = gets(arg, 1i) then
          fail(p, arg, "duplicate parameter")
        end
        i = i + 1i
      end
      param = arena(p, 48i)
      puts(param, 0i, gets(arg, 1i))
      t = 0i
      if accept(p, 11i) then
        t = read_type(p, false)
      end
      put(param, 2i, t)
      put(param, 3i, count)
      params = list_add(p, params, param)
      count = count + 1i
      if not accept(p, 10i) or kind(p) = 7i then
        break
      end
    end
  end
  expect(p, 7i, "expected )")
  result = 0i
  if accept(p, 11i) then
    result = read_type(p, true)
  end
  if get(p, 27i) != 0i then
    if count != 3i or result != 6i then
      fail(p, tok, "task signature must be (data: buffer, begin: int, finish: int): void")
    end
    if get(list_get(params, 0i), 2i) != 4i or get(list_get(params, 1i), 2i) != 3i or get(list_get(params, 2i), 2i) != 3i then
      fail(p, tok, "task signature must be (data: buffer, begin: int, finish: int): void")
    end
  end
  put(f, 3i, result)
  putp(f, 4i, params)
  put(f, 5i, count)
  expect(p, 1i, "expected newline after function signature")
  if getp(p, 8i) = nil() then
    putp(p, 8i, f)
  else
    putp(getp(p, 9i), 8i, f)
  end
  putp(p, 9i, f)
  bucket = name_bucket(name)
  table = getp(p, 26i)
  putp(f, 10i, getp(table, bucket))
  putp(table, bucket, f)
  saved_scope = getp(p, 6i)
  saved_slots = get(p, 7i)
  putp(p, 6i, nil())
  push_scope(p)
  put(p, 7i, count)
  put(p, 15i, result)
  i = 0i
  while i < count do
    arg = list_get(params, i)
    bind_name(p, gets(arg, 0i), get(arg, 2i), get(arg, 3i))
    i = i + 1i
  end
  body = block(p, 0i)
  putp(f, 6i, body)
  put(f, 7i, get(p, 7i))
  expect(p, 28i, "expected end after function")
  finish_line(p)
  if result != 6i and not returns(body) then
    fail(p, tok, "non-void function must return on every path")
  end
  putp(p, 6i, saved_scope)
  put(p, 7i, saved_slots)
  put(p, 15i, -1i)
end
fn parse(source: string, filename: string): pointer
  p = new_arena(67108864i, 256i)
  putp(p, 26i, raw(8192i))
  puts(p, 19i, filename)
  puts(p, 21i, source)
  put(p, 15i, -1i)
  push_scope(p)
  lex(p, source)
  head = nil()
  tail = nil()
  skip_lines(p)
  while kind(p) != 0i do
    put(p, 27i, 0i)
    if accept(p, 57i) then
      put(p, 27i, 1i)
    end
    if get(p, 27i) != 0i and kind(p) != 39i then
      fail(p, peek(p), "task must be followed by fn")
    end
    if accept(p, 39i) then
      function_definition(p)
    else
      if kind(p) = 28i or kind(p) = 27i or kind(p) = 54i then
        fail(p, peek(p), "unexpected end, else, or elif")
      end
      item = block(p, 1i)
      need(item != nil(), "internal empty top-level statement")
      if head = nil() then
        head = item
      else
        putp(tail, 11i, item)
      end
      tail = item
    end
    skip_lines(p)
  end
  putp(p, 10i, head)
  put(p, 11i, get(p, 7i))
  return p
end
# Code context after arena fields: code=3,size=4,next label=5,labels=6,
# relocations head/tail=7/8, constants head/tail=9/10, instruction bytes=11,
# string offset=12,payload bytes=13,return label=14,loop chain=15.
fn emit(c: pointer, word: int): void
  pos = get(c, 4i)
  need(pos >= 0i and pos <= 33554428i, "generated code exceeds 32 MiB")
  unsafe
    poke32(offset(getp(c, 3i), pos), word)
  end
  put(c, 4i, pos + 4i)
end
fn mark(c: pointer, label: int, pos: int): void
  need(label > 0i and label < 262144i, "label limit exceeded")
  labels = getp(c, 6i)
  need(get(labels, label) = 0i, "duplicate machine-code label")
  put(labels, label, pos + 1i)
end
fn fresh(c: pointer): int
  label = get(c, 5i)
  need(label > 0i and label < 262144i, "label limit exceeded")
  put(c, 5i, label + 1i)
  return label
end
fn label_here(c: pointer, label: int): void
  mark(c, label, get(c, 4i))
end
fn fixup(c: pointer, pos: int, kind: int, target: int): void
  item = arena(c, 32i)
  put(item, 0i, pos)
  put(item, 1i, kind)
  put(item, 2i, target)
  if getp(c, 7i) = nil() then
    putp(c, 7i, item)
  else
    putp(getp(c, 8i), 3i, item)
  end
  putp(c, 8i, item)
end
fn constant(c: pointer, label: int, text: string): void
  item = arena(c, 32i)
  put(item, 0i, label)
  puts(item, 1i, text)
  if getp(c, 9i) = nil() then
    putp(c, 9i, item)
  else
    putp(getp(c, 10i), 3i, item)
  end
  putp(c, 10i, item)
end
fn text_label(c: pointer, text: string): int
  if get(c, 17i) != 0i then
    h = 0i
    i = 0i
    while i < int(len(text)) do
      h = (h * 33i + byte_at(text, i)) % 1024i
      i = i + 1i
    end
    table = getp(c, 18i)
    entry = getp(table, h)
    while entry != nil() do
      if gets(entry, 1i) = text then
        return get(entry, 0i)
      end
      entry = getp(entry, 3i)
    end
    label = fresh(c)
    constant(c, label, text)
    entry = arena(c, 32i)
    put(entry, 0i, label)
    puts(entry, 1i, text)
    putp(entry, 3i, getp(table, h))
    putp(table, h, entry)
    return label
  end
  label = fresh(c)
  constant(c, label, text)
  return label
end
fn a_value(c: pointer, rd: int, bits: int): void
  if get(c, 17i) != 0i then
    zeroes = 0i
    ones = 0i
    shift = 0i
    while shift < 64i do
      half = band(shr(bits, shift), 65535i)
      if half = 0i then
        zeroes = zeroes + 1i
      end
      if half = 65535i then
        ones = ones + 1i
      end
      shift = shift + 16i
    end
    if ones > zeroes then
      shift = 0i
      first = true
      while shift < 64i do
        half = band(shr(bits, shift), 65535i)
        if half != 65535i or (first and shift = 48i) then
          op = 0xF2800000
          part = half
          if first then
            first = false
            op = 0x92800000
            part = bxor(half, 65535i)
          end
          emit(c, bor(op, bor(shl(shift / 16i, 21i), bor(shl(part, 5i), rd))))
        end
        shift = shift + 16i
      end
      return
    end
  end
  emit(c, bor(0xD2800000, bor(shl(band(bits, 65535i), 5i), rd)))
  shift = 16i
  while shift < 64i do
    part = band(shr(bits, shift), 65535i)
    if part != 0i then
      emit(c, bor(0xF2800000, bor(shl(shift / 16i, 21i), bor(shl(part, 5i), rd))))
    end
    shift = shift + 16i
  end
end
fn a_mov(c: pointer, rd: int, rn: int): void
  emit(c, bor(0xAA0003E0, bor(shl(rn, 16i), rd)))
end
fn a_add(c: pointer, rd: int, rn: int, rm: int): void
  emit(c, bor(0x8B000000, bor(shl(rm, 16i), bor(shl(rn, 5i), rd))))
end
fn a_addshift(c: pointer, rd: int, rn: int, rm: int, shift: int): void
  emit(c, bor(0x8B000000, bor(shl(rm, 16i), bor(shl(shift, 10i), bor(shl(rn, 5i), rd)))))
end
fn a_sub(c: pointer, rd: int, rn: int, rm: int): void
  emit(c, bor(0xCB000000, bor(shl(rm, 16i), bor(shl(rn, 5i), rd))))
end
fn a_immediate(c: pointer, rd: int, rn: int, amount: int, down: bool, high: bool): void
  need(amount >= 0i and amount < 4096i, "bad internal immediate")
  op = 0x91000000
  if down then
    op = 0xD1000000
  end
  if high then
    op = bor(op, 0x400000)
  end
  emit(c, bor(op, bor(shl(amount, 10i), bor(shl(rn, 5i), rd))))
end
fn a_addi(c: pointer, rd: int, rn: int, amount: int): void
  a_immediate(c, rd, rn, amount, false, false)
end
fn a_subi(c: pointer, rd: int, rn: int, amount: int): void
  a_immediate(c, rd, rn, amount, true, false)
end
fn a_stack(c: pointer, bytes: int, down: bool): void
  need(bytes >= 0i and bytes <= 32768i and bytes % 16i = 0i, "bad stack size")
  if bytes / 4096i != 0i then
    a_immediate(c, 31i, 31i, bytes / 4096i, down, true)
  end
  if bytes % 4096i != 0i then
    a_immediate(c, 31i, 31i, bytes % 4096i, down, false)
  end
end
fn a_load(c: pointer, rd: int, base: int, bytes: int): void
  need(bytes >= 0i and bytes <= 32760i and bytes % 8i = 0i, "bad load offset")
  emit(c, bor(0xF9400000, bor(shl(bytes / 8i, 10i), bor(shl(base, 5i), rd))))
end
fn a_store(c: pointer, rd: int, base: int, bytes: int): void
  need(bytes >= 0i and bytes <= 32760i and bytes % 8i = 0i, "bad store offset")
  emit(c, bor(0xF9000000, bor(shl(bytes / 8i, 10i), bor(shl(base, 5i), rd))))
end
fn a_width(c: pointer, rd: int, base: int, width: int, read: bool): void
  op = 0x39000000
  if width = 2i then
    op = 0x79000000
  end
  if width = 4i then
    op = 0xB9000000
  end
  if width = 8i then
    op = 0xF9000000
  end
  if read then
    op = bor(op, 0x400000)
  end
  emit(c, bor(op, bor(shl(base, 5i), rd)))
end
fn a_cmp(c: pointer, rn: int, rm: int): void
  emit(c, bor(0xEB00001F, bor(shl(rm, 16i), shl(rn, 5i))))
end
fn a_cmpi(c: pointer, rn: int, imm: int): void
  need(imm >= 0i and imm < 4096i, "bad comparison immediate")
  emit(c, bor(0xF100001F, bor(shl(imm, 10i), shl(rn, 5i))))
end
fn a_cset(c: pointer, rd: int, condition: int): void
  emit(c, bor(0x9A9F07E0, bor(shl(bxor(condition, 1i), 12i), rd)))
end
fn a_branch(c: pointer, label: int, link: bool): void
  fixup(c, get(c, 4i), 0i, label)
  op = 0x14000000
  if link then
    op = 0x94000000
  end
  emit(c, op)
end
fn a_condition(c: pointer, condition: int, label: int): void
  emit(c, bor(0x54000040, bxor(condition, 1i)))
  a_branch(c, label, false)
end
fn a_zero(c: pointer, rn: int, label: int, nonzero: bool): void
  op = 0xB5000040
  if nonzero then
    op = 0xB4000040
  end
  emit(c, bor(op, rn))
  a_branch(c, label, false)
end
fn a_address(c: pointer, rd: int, label: int): void
  fixup(c, get(c, 4i), 2i, label)
  emit(c, bor(0x90000000, rd))
  emit(c, bor(0x91000000, bor(shl(rd, 5i), rd)))
end
fn a_op3(c: pointer, op: int, rd: int, rn: int, rm: int): void
  emit(c, bor(op, bor(shl(rm, 16i), bor(shl(rn, 5i), rd))))
end
fn a_neg(c: pointer, rd: int, rn: int, flags: bool): void
  op = 0xCB0003E0
  if flags then
    op = 0xEB0003E0
  end
  emit(c, bor(op, bor(shl(rn, 16i), rd)))
end
fn a_msub(c: pointer, rd: int, rn: int, rm: int, ra: int): void
  a_op3(c, bor(0x9B008000, shl(ra, 10i)), rd, rn, rm)
end
fn a_right(c: pointer, rd: int, rn: int, shift: int, signed: bool): void
  op = 0xD340FC00
  if signed then
    op = 0x9340FC00
  end
  emit(c, bor(op, bor(shl(shift, 16i), bor(shl(rn, 5i), rd))))
end
fn a_fmov(c: pointer, dest: int, source: int, to_float: bool): void
  op = 0x9E660000
  if to_float then
    op = 0x9E670000
  end
  emit(c, bor(op, bor(shl(source, 5i), dest)))
end
fn a_fconstant(c: pointer, rd: int, bits: int): void
  a_value(c, 9i, bits)
  a_fmov(c, rd, 9i, true)
end
fn a_fcmp(c: pointer, rn: int, rm: int): void
  a_op3(c, 0x1E602000, 0i, rn, rm)
end
fn a_fbinary(c: pointer, rd: int, rn: int, rm: int, name: string): void
  op = 0x1E602800
  if name = "-" then
    op = 0x1E603800
  end
  if name = "*" then
    op = 0x1E600800
  end
  if name = "/" then
    op = 0x1E601800
  end
  a_op3(c, op, rd, rn, rm)
end
fn store_slot(c: pointer, slot: int): void
  a_store(c, 0i, 28i, slot * 16i)
  a_store(c, 1i, 28i, slot * 16i + 8i)
end
fn load_slot(c: pointer, slot: int): void
  a_load(c, 0i, 28i, slot * 16i)
  a_load(c, 1i, 28i, slot * 16i + 8i)
end
fn push_value(c: pointer): void
  a_stack(c, 16i, true)
  a_store(c, 0i, 31i, 0i)
  a_store(c, 1i, 31i, 8i)
end
fn pop_left(c: pointer): void
  a_load(c, 2i, 31i, 0i)
  a_load(c, 3i, 31i, 8i)
  a_stack(c, 16i, false)
end
fn raw_copy(dst: pointer, src: pointer, bytes: int): void
  i = 0i
  unsafe
    while i + 8i <= bytes do
      poke64(offset(dst, i), peek64(offset(src, i)))
      i = i + 8i
    end
    while i < bytes do
      poke8(offset(dst, i), peek8(offset(src, i)))
      i = i + 1i
    end
  end
end
# Source inclusion uses one bounded output arena; each lexical path is included once.
fn path_normal(path: string): string
  assert(len(path) > 0 and len(path) < 4096)
  b = alloc(4096i)
  marks = alloc(4096i * 8i)
  count = 0i
  size = 0i
  root = byte_at(path, 0i) = 47i
  if root then
    b[0] = 47i
    size = 1i
  end
  i = 0i
  while i < int(len(path)) do
    start = i
    while i < int(len(path)) and byte_at(path, i) != 47i do
      if byte_at(path, i) = 10i or byte_at(path, i) = 13i then
        die("newlines are not permitted in source paths", 65i)
      end
      i = i + 1i
    end
    part = slice(path, start, i - start)
    i = i + 1i
    if part = "" or part = "." then
      continue
    end
    if part = ".." and count > 0i then
      last = load64(marks, (count - 1i) * 8i)
      skip = last
      if skip < size and int(b[skip]) = 47i then
        skip = skip + 1i
      end
      prior = ""
      unsafe
        prior = view(b, skip, size - skip)
      end
      if prior != ".." then
        size = last
        count = count - 1i
        continue
      end
    end
    if part = ".." and root and count = 0i then
      continue
    end
    store64(marks, count * 8i, size)
    count = count + 1i
    if size > 0i and int(b[size - 1i]) != 47i then
      b[size] = 47i
      size = size + 1i
    end
    copy(b, size, part, 0i, len(part))
    size = size + int(len(part))
  end
  free(marks)
  if size = 0i then
    b[0] = 46i
    size = 1i
  end
  unsafe
    return view(b, 0i, size)
  end
end
fn source_parent(path: string): string
  slash = -1i
  i = 0i
  while i < int(len(path)) do
    if byte_at(path, i) = 47i then
      slash = i
    end
    i = i + 1i
  end
  if slash < 0i then
    return ""
  end
  return slice(path, 0i, slash + 1i)
end
fn environment(name: string): string
  unsafe
    env = envp()
    j = 0i
    while j < 65536i do
      entry = pointer(peek64(offset(env, j * 8i)))
      if entry = nil() then
        return ""
      end
      size = 0i
      while size < 65536i and int(peek8(offset(entry, size))) != 0i do
        size = size + 1i
      end
      text = string_at(entry, size)
      n = int(len(name))
      if size > n and slice(text, 0i, n) = name and byte_at(text, n) = 61i then
        return slice(text, n + 1i, size - n - 1i)
      end
      j = j + 1i
    end
  end
  return ""
end
fn file_exists(path: string): bool
  text = cstring(path)
  unsafe
    fd = syscall(5i, address(text), 0i, 0i, 0i, 0i, 0i)
    free(text)
    if fd < 0i then
      return false
    end
    syscall(6i, fd, 0i, 0i, 0i, 0i, 0i)
  end
  return true
end
fn executable_name(): string
  name = arg(0i)
  i = 0i
  while i < int(len(name)) do
    if byte_at(name, i) = 47i then
      return name
    end
    i = i + 1i
  end
  search = environment("PATH")
  i = 0i
  while i <= int(len(search)) do
    begin = i
    while i < int(len(search)) and byte_at(search, i) != 58i do
      i = i + 1i
    end
    directory = slice(search, begin, i - begin)
    if directory = "" then
      directory = "."
    end
    candidate = concat(concat(directory, "/"), name)
    if file_exists(candidate) then
      return candidate
    end
    i = i + 1i
  end
  return name
end
fn library_root(): string
  override = environment("APO_LIB")
  if override != "" then
    return path_normal(override)
  end
  return path_normal(concat(source_parent(executable_name()), "lib"))
end

fn source_append(state: pointer, text: string): void
  n = int(len(text))
  used = get(state, 1i)
  if n > 8388608i - used then
    die("expanded source exceeds 8 MiB", 65i)
  end
  unsafe
    raw_copy(at(getp(state, 0i), used), address(text), n)
  end
  put(state, 1i, used + n)
end
fn source_marker(state: pointer, file: string, line: int): void
  source_append(state, "#@apo-file:")
  source_append(state, strint(line))
  source_append(state, ":")
  source_append(state, file)
  source_append(state, "\n")
end
fn expand_file(state: pointer, filename: string, depth: int): void
  if depth > 16i then
    die("use nesting exceeds 16", 65i)
  end
  path = path_normal(filename)
  entry = getp(state, 2i)
  while entry != nil() do
    if gets(entry, 0i) = path then
      if get(entry, 2i) = 1i then
        die(concat("cyclic use: ", path), 65i)
      end
      return
    end
    entry = getp(entry, 3i)
  end
  if get(state, 3i) >= 64i then
    die("use limit is 64 source files", 65i)
  end
  put(state, 3i, get(state, 3i) + 1i)
  entry = raw(32i)
  puts(entry, 0i, path)
  put(entry, 2i, 1i)
  putp(entry, 3i, getp(state, 2i))
  putp(state, 2i, entry)
  source = read_source(path)
  source_marker(state, path, 1i)
  pos = 0i
  line = 1i
  while pos < int(len(source)) do
    begin = pos
    while pos < int(len(source)) and byte_at(source, pos) != 10i and byte_at(source, pos) != 13i do
      pos = pos + 1i
    end
    text = slice(source, begin, pos - begin)
    if pos < int(len(source)) then
      ch = byte_at(source, pos)
      pos = pos + 1i
      if ch = 13i and source_byte(source, pos) = 10i then
        pos = pos + 1i
      end
    end
    if starts(text, "use ") or starts(text, "use\t") then
      i = 3i
      while i < int(len(text)) and (byte_at(text, i) = 32i or byte_at(text, i) = 9i) do
        i = i + 1i
      end
      imported = ""
      named = source_byte(text, i) != 34i
      if named then
        start = i
        if not isletter(source_byte(text, i)) and source_byte(text, i) != 95i then
          die(concat(path, ": expected a library name or quoted .apo path after use"), 65i)
        end
        while i < int(len(text)) and isident(byte_at(text, i)) do
          i = i + 1i
        end
        name = slice(text, start, i - start)
        imported = concat(concat(gets(state, 4i), "/"), concat(name, ".apo"))
        if not file_exists(imported) then
          die(concat(concat("library not found: ", name), concat("; searched ", concat(imported, "; set APO_LIB or pass --lib-dir"))), 66i)
        end
      else
        i = i + 1i
        start = i
        while i < int(len(text)) and byte_at(text, i) != 34i do
          if byte_at(text, i) = 92i then
            die("use paths must not contain backslash escapes", 65i)
          end
          i = i + 1i
        end
        if i >= int(len(text)) or i = start then
          die("invalid use path", 65i)
        end
        imported = slice(text, start, i - start)
        i = i + 1i
        if byte_at(imported, 0i) != 47i then
          imported = concat(source_parent(path), imported)
        end
      end
      while i < int(len(text)) and (byte_at(text, i) = 32i or byte_at(text, i) = 9i) do
        i = i + 1i
      end
      if i < int(len(text)) and byte_at(text, i) != 35i and not starts(slice(text, i, int(len(text)) - i), "//") then
        die("only a line comment may follow use", 65i)
      end
      if not apo_suffix(imported) then
        die("use path must end in .apo", 65i)
      end
      expand_file(state, imported, depth + 1i)
      source_marker(state, path, line + 1i)
    else
      source_append(state, text)
      source_append(state, "\n")
    end
    line = line + 1i
  end
  put(entry, 2i, 0i)
end
fn load_program(path: string, libraries: string): string
  state = raw(48i)
  puts(state, 4i, libraries)
  putp(state, 0i, raw(8388609i))
  expand_file(state, path, 0i)
  return rawtext(getp(state, 0i), get(state, 1i))
end

fn finish_code(c: pointer): void
  size = get(c, 4i)
  put(c, 11i, size)
  size = band(size + 15i, -16i)
  put(c, 12i, size)
  item = getp(c, 9i)
  data = getp(c, 3i)
  while item != nil() do
    n = get(item, 2i)
    need(size + n + 1i <= 33554432i, "payload exceeds 32 MiB")
    mark(c, get(item, 0i), size)
    raw_copy(at(data, size), getp(item, 1i), n)
    setb(data, size + n, 0i)
    size = size + n + 1i
    item = getp(item, 3i)
  end
  put(c, 13i, size)
  data_offset = ((4096i + size + 16383i) / 16384i) * 16384i - 4096i
  if get(c, 25i) != 0i then
    mark(c, get(c, 25i), data_offset)
  end
  if get(c, 26i) != 0i then
    mark(c, get(c, 26i), data_offset + 8i)
  end
  fix = getp(c, 7i)
  labels = getp(c, 6i)
  while fix != nil() do
    where = get(fix, 0i)
    kind = get(fix, 1i)
    target = get(labels, get(fix, 2i)) - 1i
    need(target >= 0i, "unresolved native label")
    unsafe
      word = int(peek32(at(data, where)))
      if kind = 2i then
        pages = (4096i + target) / 4096i - (4096i + where) / 4096i
        need(pages >= -1048576i and pages < 1048576i, "ADRP range exceeded")
        bits = band(pages, 0x1fffff)
        word = bor(word, bor(shl(band(bits, 3i), 29i), shl(shr(bits, 2i), 5i)))
        next = int(peek32(at(data, where + 4i)))
        poke32(at(data, where + 4i), bor(next, shl(band(4096i + target, 4095i), 10i)))
      else
        difference = target - where
        need(difference % 4i = 0i, "unaligned branch target")
        distance = difference / 4i
        need(distance >= -33554432i and distance < 33554432i, "branch range exceeded")
        word = bor(word, band(distance, 0x3ffffff))
      end
      poke32(at(data, where), word)
    end
    fix = getp(fix, 3i)
  end
end
# ARM64 runtime source: fixed instructions plus explicit label relocations.
# Every word is emitted by APO itself; no external assembler or linker.
fn runtime_id(name: string): int
  if name = "error.assert" then
    return 6i
  end
  if name = "error.bounds" then
    return 7i
  end
  if name = "error.byte" then
    return 8i
  end
  if name = "error.exit" then
    return 9i
  end
  if name = "error.float" then
    return 10i
  end
  if name = "error.freed" then
    return 11i
  end
  if name = "error.int_overflow" then
    return 12i
  end
  if name = "error.integer" then
    return 13i
  end
  if name = "error.memory" then
    return 14i
  end
  if name = "error.overflow" then
    return 15i
  end
  if name = "error.precision" then
    return 16i
  end
  if name = "error.shift" then
    return 17i
  end
  if name = "error.size" then
    return 18i
  end
  if name = "error.stack" then
    return 19i
  end
  if name = "error.time" then
    return 20i
  end
  if name = "error.zero" then
    return 21i
  end
  if name = "program.entry" then
    return 55i
  end
  if name = "runtime.alloc" then
    return 56i
  end
  if name = "runtime.bounds" then
    return 57i
  end
  if name = "runtime.clock" then
    return 58i
  end
  if name = "runtime.divide" then
    return 59i
  end
  if name = "runtime.float_print" then
    return 60i
  end
  if name = "runtime.free" then
    return 61i
  end
  if name = "runtime.integer_print" then
    return 62i
  end
  if name = "runtime.muldiv" then
    return 63i
  end
  if name = "runtime.multiply" then
    return 64i
  end
  if name = "runtime.number" then
    return 65i
  end
  if name = "runtime.pointer_print" then
    return 66i
  end
  if name = "runtime.rawclock" then
    return 67i
  end
  if name = "runtime.sleep" then
    return 68i
  end
  if name = "runtime.sleep_common" then
    return 69i
  end
  if name = "runtime.sleep_until" then
    return 70i
  end
  if name = "runtime.string_equal" then
    return 71i
  end
  if name = "runtime.validate" then
    return 72i
  end
  if name = "runtime.write" then
    return 73i
  end
  print: "internal error: unknown runtime label ", name, \nl
  exit 70i
end

fn emit_runtime(c: pointer): void
  emit(c, 0x14000000) # b program.entry
  mark(c, 73i, 4i) # runtime.write
  emit(c, 0xaa0003e9) # mov register
  emit(c, 0xaa0103ea) # mov register
  emit(c, 0xaa0203eb) # mov register
  emit(c, 0xb500004b) # cb.inverse +8
  emit(c, 0x14000000) # b write.done.1
  mark(c, 103i, 24i) # write.loop.0
  emit(c, 0xaa0903e0) # mov register
  emit(c, 0xaa0a03e1) # mov register
  emit(c, 0xaa0b03e2) # mov register
  emit(c, 0xd2800090) # movz x16
  emit(c, 0xd4001001) # svc #0x80
  emit(c, 0x54000043) # b.inverse +8
  emit(c, 0x14000000) # b write.error.2
  emit(c, 0xb5000040) # cb.inverse +8
  emit(c, 0x14000000) # b write.io.3
  emit(c, 0x8b00014a) # add registers
  emit(c, 0xcb00016b) # sub registers
  emit(c, 0xb400004b) # cb.inverse +8
  emit(c, 0x14000000) # b write.loop.0
  mark(c, 100i, 76i) # write.done.1
  emit(c, 0xd65f03c0) # ret
  mark(c, 101i, 80i) # write.error.2
  emit(c, 0xf100101f) # cmp immediate
  emit(c, 0x54000041) # b.inverse +8
  emit(c, 0x14000000) # b write.loop.0
  mark(c, 102i, 92i) # write.io.3
  emit(c, 0xd2800940) # movz x0
  emit(c, 0xd2800030) # movz x16
  emit(c, 0xd4001001) # svc #0x80
  emit(c, 0xd4200000) # brk #0
  mark(c, 65i, 108i) # runtime.number
  emit(c, 0xd10183ff) # sub immediate
  emit(c, 0xf9002bfd) # str x29
  emit(c, 0xf9002ffe) # str x30
  emit(c, 0x910143fd) # add immediate
  emit(c, 0x910103e4) # add immediate
  emit(c, 0xaa0403f1) # mov register
  emit(c, 0xaa0003ec) # mov register
  emit(c, 0xd280000f) # movz x15
  emit(c, 0xf100001f) # cmp immediate
  emit(c, 0x5400004b) # b.inverse +8
  emit(c, 0x14000000) # b number.positive.4
  emit(c, 0xcb0c03ec) # neg
  emit(c, 0xd280002f) # movz x15
  mark(c, 51i, 160i) # number.positive.4
  emit(c, 0xd2884810) # movz x16
  emit(c, 0xf2a001f0) # movk x16
  emit(c, 0x9ad0098d) # udiv
  emit(c, 0x9b10b1ae) # msub (remainder)
  emit(c, 0xd2800148) # movz x8
  emit(c, 0xb500004e) # cb.inverse +8
  emit(c, 0x14000000) # b number.integer.5
  emit(c, 0xd28000c7) # movz x7
  mark(c, 29i, 192i) # fraction.trim.6
  emit(c, 0x9ac809c6) # udiv
  emit(c, 0x9b08b8c5) # msub (remainder)
  emit(c, 0xb4000045) # cb.inverse +8
  emit(c, 0x14000000) # b fraction.digits.7
  emit(c, 0xaa0603ee) # mov register
  emit(c, 0xd10004e7) # sub immediate
  emit(c, 0x14000000) # b fraction.trim.6
  mark(c, 28i, 220i) # fraction.digits.7
  emit(c, 0x9ac809c6) # udiv
  emit(c, 0x9b08b8c5) # msub (remainder)
  emit(c, 0x9100c0a5) # add immediate
  emit(c, 0xd1000631) # sub immediate
  emit(c, 0x39000225) # strb
  emit(c, 0xaa0603ee) # mov register
  emit(c, 0xd10004e7) # sub immediate
  emit(c, 0xb4000047) # cb.inverse +8
  emit(c, 0x14000000) # b fraction.digits.7
  emit(c, 0xd1000631) # sub immediate
  emit(c, 0xd28005c5) # movz x5
  emit(c, 0x39000225) # strb
  mark(c, 50i, 268i) # number.integer.5
  emit(c, 0x9ac809a6) # udiv
  emit(c, 0x9b08b4c5) # msub (remainder)
  emit(c, 0x9100c0a5) # add immediate
  emit(c, 0xd1000631) # sub immediate
  emit(c, 0x39000225) # strb
  emit(c, 0xaa0603ed) # mov register
  emit(c, 0xb400004d) # cb.inverse +8
  emit(c, 0x14000000) # b number.integer.5
  emit(c, 0xb500004f) # cb.inverse +8
  emit(c, 0x14000000) # b number.write.8
  emit(c, 0xd1000631) # sub immediate
  emit(c, 0xd28005a5) # movz x5
  emit(c, 0x39000225) # strb
  mark(c, 52i, 320i) # number.write.8
  emit(c, 0xd2800020) # movz x0
  emit(c, 0xaa1103e1) # mov register
  emit(c, 0xcb110082) # sub registers
  emit(c, 0x94000000) # bl runtime.write
  emit(c, 0xf9402bfd) # ldr x29
  emit(c, 0xf9402ffe) # ldr x30
  emit(c, 0x910183ff) # add immediate
  emit(c, 0xd65f03c0) # ret
  mark(c, 62i, 352i) # runtime.integer_print
  emit(c, 0xd10103ff) # sub immediate
  emit(c, 0xf9001bfd) # str x29
  emit(c, 0xf9001ffe) # str x30
  emit(c, 0x9100c3fd) # add immediate
  emit(c, 0x9100a3e4) # add immediate
  emit(c, 0xaa0403f1) # mov register
  emit(c, 0xaa0003ec) # mov register
  emit(c, 0xd280000f) # movz x15
  emit(c, 0xf100019f) # cmp immediate
  emit(c, 0x5400004b) # b.inverse +8
