  if name = "arg" then
    return "S-I"
  end
  if name = "envp" then
    return "P!"
  end
  if name = "clock" then
    return "Nt"
  end
  if name = "sleep" then
    return "VtN"
  end
  if name = "sleep_until" then
    return "VtN"
  end
  if name = "int" then
    return "I-C"
