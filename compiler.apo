  if name = "byte_at" then
    return "I-SR"
  end
  if name = "slice" then
    return "S-SRR"
  end
  if name = "view" then
    return "S!BRR"
  end
  if name = "string_at" then
    return "S!PR"
  end
  if name = "copy" then
    return "V-BRTRR"
  end
  if name = "address" then
    return "P!T"
  end
  if name = "pointer" then
    return "P!I"
  end
  if name = "address_int" then
    return "I!P"
  end
  if name = "offset" then
    return "P!PR"
  end
  if name = "band" then
    return "I-II"
  end
  if name = "bor" then
    return "I-II"
  end
  if name = "bxor" then
    return "I-II"
