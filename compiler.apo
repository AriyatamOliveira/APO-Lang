  fixup(c, 2824i, 2i, 90i)
  fixup(c, 2836i, 0i, 73i)
  fixup(c, 2860i, 2i, 91i)
  fixup(c, 2872i, 0i, 73i)
  fixup(c, 2896i, 2i, 92i)
  fixup(c, 2908i, 0i, 73i)
  fixup(c, 2932i, 2i, 93i)
  fixup(c, 2944i, 0i, 73i)
  fixup(c, 2968i, 2i, 94i)
  fixup(c, 2980i, 0i, 73i)
  fixup(c, 3004i, 2i, 95i)
  fixup(c, 3016i, 0i, 73i)
  fixup(c, 3040i, 2i, 96i)
  fixup(c, 3052i, 0i, 73i)
  put(c, 5i, 104i) # next available label
end
fn rtcall(c: pointer, name: string): void
  a_branch(c, runtime_id(name), true)
end
fn rtcond(c: pointer, cond: int, name: string): void
  a_condition(c, cond, runtime_id(name))
end
fn rtzero(c: pointer, reg: int, name: string, nonzero: bool): void
  a_zero(c, reg, runtime_id(name), nonzero)
end
fn finite_value(c: pointer): void
  a_right(c, 9i, 0i, 52i, false)
  a_value(c, 10i, 2047i)
  a_op3(c, 0x8A000000, 9i, 9i, 10i)
  a_cmpi(c, 9i, 2047i)
  rtcond(c, 0i, "error.float")
end
fn argument_type(e: pointer, index: int): int
  return get(list_get(getp(e, 9i), index), 1i)
end
fn unscale(c: pointer, reg: int, datatype: int): void
  if datatype = 3i then
    return
  end
  a_value(c, 9i, 1000000i)
  a_op3(c, 0x9AC00C00, 10i, reg, 9i)
  a_msub(c, 11i, 10i, 9i, reg)
  rtzero(c, 11i, "error.integer", true)
  a_mov(c, reg, 10i)
end
fn to_number(c: pointer, reg: int): void
  a_value(c, 9i, 1000000i)
  a_op3(c, 0x9B407C00, 10i, reg, 9i)
  a_op3(c, 0x9B007C00, reg, reg, 9i)
  a_right(c, 11i, reg, 63i, true)
  a_cmp(c, 10i, 11i)
  rtcond(c, 1i, "error.overflow")
end
fn unsigned_width(c: pointer, reg: int, width: int): void
  limit = 255i
  if width = 2i then
    limit = 65535i
  end
  if width = 4i then
    limit = 4294967295i
  end
  a_value(c, 9i, limit)
  a_cmp(c, reg, 9i)
  rtcond(c, 8i, "error.byte")
end
fn finish_intrinsic(c: pointer, e: pointer): void
  if get(e, 1i) = 6i then
    a_value(c, 0i, 0i)
  end
  a_value(c, 1i, 0i)
end
fn write_value(c: pointer): void
  a_mov(c, 2i, 1i)
  a_mov(c, 1i, 0i)
  a_value(c, 0i, 1i)
  rtcall(c, "runtime.write")
end
# Checked, clipped DDA kernel. Register-resident pixel loop; no per-pixel heap
# handle lookup or language-function stack spills. FP operations are NOT fused.
# Public contract: canvas header; ax,ay,bx,by in [-1,width/height+1]; nonnegative
# finite inverse depths <= 1e6; 1..width+height+2 samples; unsigned RGBA32.
fn emit_raster_line(c: pointer, e: pointer): void
  # Arguments were evaluated once, left-to-right, into nine 16-byte pairs.
  j = 0i
  while j < 6i do
    a_load(c, 9i, 31i, (7i - j) * 16i)
    a_fmov(c, j, 9i, true)
    j = j + 1i
  end
  a_load(c, 6i, 31i, 16i)
  a_load(c, 7i, 31i, 0i)
  a_load(c, 0i, 31i, 128i)
  a_load(c, 1i, 31i, 136i)
  a_stack(c, 144i, false)
  rtcall(c, "runtime.validate")
  # X8=live allocation, X9=length. Reject a short header before any field load.
  a_cmpi(c, 9i, 64i)
  rtcond(c, 3i, "error.bounds")
  a_load(c, 2i, 8i, 0i)
  a_load(c, 3i, 8i, 8i)
  a_load(c, 4i, 8i, 16i)
  a_load(c, 13i, 8i, 24i)
  a_value(c, 14i, 0x41504f3344323030)
  a_cmp(c, 13i, 14i)
  rtcond(c, 1i, "error.bounds")
  a_cmpi(c, 2i, 16i)
  rtcond(c, 3i, "error.bounds")
  a_cmpi(c, 2i, 2048i)
  rtcond(c, 8i, "error.bounds")
  a_cmpi(c, 3i, 16i)
  rtcond(c, 3i, "error.bounds")
  a_cmpi(c, 3i, 2048i)
  rtcond(c, 8i, "error.bounds")
  a_op3(c, 0x9B007C00, 13i, 2i, 3i)
  a_value(c, 14i, 64i)
  a_addshift(c, 14i, 14i, 13i, 2i)
  a_cmp(c, 4i, 14i)
  rtcond(c, 3i, "error.bounds")
  a_value(c, 15i, 0i)
  a_addshift(c, 15i, 15i, 13i, 3i)
  a_cmp(c, 9i, 15i)
  rtcond(c, 3i, "error.bounds")
  a_sub(c, 9i, 9i, 15i)
  a_cmp(c, 4i, 9i)
  rtcond(c, 8i, "error.bounds")
  a_cmpi(c, 6i, 1i)
  rtcond(c, 3i, "error.bounds")
  a_add(c, 15i, 2i, 3i)
  a_addi(c, 15i, 15i, 2i)
  a_cmp(c, 6i, 15i)
  rtcond(c, 8i, "error.bounds")
  a_value(c, 14i, 0xffffffff)
  a_cmp(c, 7i, 14i)
  rtcond(c, 8i, "error.byte")
  a_addi(c, 0i, 8i, 64i)
  a_add(c, 1i, 8i, 4i)
  # Validate finite endpoint ranges before float-to-integer conversion.
  a_fconstant(c, 16i, 0xbff0000000000000) # -1.0
  a_addi(c, 14i, 2i, 1i)
  emit(c, 0x9E620000 + shl(14i, 5i) + 17i) # scvtf d17,x14
  a_addi(c, 14i, 3i, 1i)
  emit(c, 0x9E620000 + shl(14i, 5i) + 18i)
  j = 0i
  while j < 4i do
    a_fcmp(c, j, 16i)
    rtcond(c, 6i, "error.float")
    rtcond(c, 11i, "error.bounds")
    a_fcmp(c, j, 17i + (j % 2i))
    rtcond(c, 12i, "error.bounds")
    j = j + 1i
  end
  a_fconstant(c, 16i, 0i)
  a_fconstant(c, 17i, 0x412e848000000000) # 1e6
  j = 4i
  while j < 6i do
    a_fcmp(c, j, 16i)
    rtcond(c, 6i, "error.float")
    rtcond(c, 11i, "error.bounds")
    a_fcmp(c, j, 17i)
    rtcond(c, 12i, "error.bounds")
    j = j + 1i
  end
  a_fbinary(c, 2i, 2i, 0i, "-")
  a_fbinary(c, 3i, 3i, 1i, "-")
  a_fbinary(c, 5i, 5i, 4i, "-")
  emit(c, 0x9E620000 + shl(6i, 5i) + 6i)
  a_fconstant(c, 16i, 0x3fe0000000000000) # 0.5
  a_value(c, 10i, 0i)
  loop = fresh(c)
  skip = fresh(c)
  label_here(c, loop)
  emit(c, 0x9E620000 + shl(10i, 5i) + 7i)
  a_fbinary(c, 7i, 7i, 6i, "/")
  a_fbinary(c, 17i, 2i, 7i, "*")
  a_fbinary(c, 17i, 0i, 17i, "+")
  a_fbinary(c, 17i, 17i, 16i, "+")
  emit(c, 0x1E654000 + shl(17i, 5i) + 17i) # frintm d17,d17
  emit(c, 0x9E780000 + shl(17i, 5i) + 4i) # fcvtzs x4,d17
  a_cmp(c, 4i, 2i)
  a_condition(c, 2i, skip) # unsigned also rejects negative X
  a_fbinary(c, 18i, 3i, 7i, "*")
  a_fbinary(c, 18i, 1i, 18i, "+")
  a_fbinary(c, 18i, 18i, 16i, "+")
  emit(c, 0x1E654000 + shl(18i, 5i) + 18i)
  emit(c, 0x9E780000 + shl(18i, 5i) + 5i)
  a_cmp(c, 5i, 3i)
  a_condition(c, 2i, skip)
  a_fbinary(c, 19i, 5i, 7i, "*")
  a_fbinary(c, 19i, 4i, 19i, "+")
  emit(c, 0x9B000000 + shl(2i, 16i) + shl(4i, 10i) + shl(5i, 5i) + 9i) # madd x9,x5,x2,x4
  a_addshift(c, 12i, 1i, 9i, 3i)
  emit(c, 0xFD400000 + shl(12i, 5i) + 20i) # ldr d20,[x12]
  a_fcmp(c, 19i, 20i)
  a_condition(c, 11i, skip) # lower OR unordered => no store
  emit(c, 0xFD000000 + shl(12i, 5i) + 19i)
  a_addshift(c, 11i, 0i, 9i, 2i)
  emit(c, 0xB9000000 + shl(11i, 5i) + 7i)
  label_here(c, skip)
  a_addi(c, 10i, 10i, 1i)
  a_cmp(c, 10i, 6i)
  a_condition(c, 9i, loop)
  finish_intrinsic(c, e)
end

# Arguments have already been evaluated left to right and pushed in 16-byte pairs.
fn intrinsic(c: pointer, e: pointer): void
  n = gets(e, 4i)
  count = get(e, 10i)
  if n = "_parallel" then
    # count args: callback, data, count, lanes, apply, queue
    a_load(c, 0i, 31i, 64i)
    a_load(c, 1i, 31i, 72i)
    rtcall(c, "runtime.validate")
    a_load(c, 3i, 31i, 80i)
    a_load(c, 16i, 31i, 16i)
    rtzero(c, 3i, "error.bounds", false)
    rtzero(c, 16i, "error.bounds", false)
    a_load(c, 10i, 31i, 48i)
    a_load(c, 11i, 31i, 32i)
    a_cmpi(c, 10i, 0i)
    rtcond(c, 11i, "error.bounds")
    a_cmpi(c, 11i, 1i)
    rtcond(c, 11i, "error.bounds")
    a_cmpi(c, 11i, 64i)
    rtcond(c, 12i, "error.bounds")
    a_load(c, 1i, 31i, 0i)
    a_stack(c, 48i, true)
    a_load(c, 12i, 31i, 112i)
    a_store(c, 12i, 31i, 0i)
    a_load(c, 12i, 31i, 120i)
    a_store(c, 12i, 31i, 8i)
    a_store(c, 27i, 31i, 16i)
    a_store(c, 10i, 31i, 24i)
    a_store(c, 11i, 31i, 32i)
    a_mov(c, 0i, 11i)
    a_addi(c, 2i, 31i, 0i)
    emit(c, 0xD63F0200)
    a_stack(c, 144i, false)
    a_value(c, 0i, 0i)
    a_value(c, 1i, 0i)
    return
  end
  if n = "_raster_line" then
    emit_raster_line(c, e)
    return
  end
  if n = "dlopen" or n = "dlsym" then
    field = 25i
    if n = "dlsym" then
      field = 26i
    end
    if get(c, field) = 0i then
      put(c, field, fresh(c))
    end
    a_load(c, 0i, 31i, 16i)
    a_load(c, 1i, 31i, 0i)
    a_address(c, 16i, get(c, field))
    a_load(c, 16i, 16i, 0i)
    a_stack(c, 32i, false)
    emit(c, 0xD63F0200)
    a_value(c, 1i, 0i)
    return
  end
  if starts(n, "ccall") then
    a_load(c, 16i, 31i, (count - 1i) * 16i)
    gp = 0i
    fp = 0i
    j = 1i
    while j < count do
      if argument_type(e, j) = 7i then
        a_load(c, 9i, 31i, (count - j - 1i) * 16i)
        a_fmov(c, fp, 9i, true)
        fp = fp + 1i
      else
        a_load(c, gp, 31i, (count - j - 1i) * 16i)
        gp = gp + 1i
      end
      j = j + 1i
    end
    a_stack(c, count * 16i, false)
    rtzero(c, 16i, "error.bounds", false)
    emit(c, 0xD63F0200) # blr x16: native C ABI, never variadic ABI.
    if starts(n, "ccallf") then
      index = 0i
      if int(len(n)) = 7i then
        index = byte_at(n, 6i) - 48i
      end
      a_fmov(c, 0i, index, false)
    end
    if n = "ccallv" then
      a_value(c, 0i, 0i)
    end
    a_value(c, 1i, 0i)
    return
  end
  if n = "syscall" or n = "asm32" then
    if n = "syscall" then
      a_load(c, 16i, 31i, (count - 1i) * 16i)
    else
      j = 0i
      while j < 6i do
        a_value(c, j, 0i)
        j = j + 1i
      end
    end
    i = 1i
    while i < count do
      a_load(c, i - 1i, 31i, (count - i - 1i) * 16i)
      i = i + 1i
    end
    a_stack(c, count * 16i, false)
    if n = "syscall" then
      emit(c, 0xD4001001)
      done = fresh(c)
      a_condition(c, 3i, done)
      a_neg(c, 0i, 0i, false)
      label_here(c, done)
    else
      emit(c, get(list_get(getp(e, 9i), 0i), 3i))
    end
    a_value(c, 1i, 0i)
    return
  end
  i = 0i
  while i < count do
    a_load(c, i * 2i, 31i, (count - i - 1i) * 16i)
    a_load(c, i * 2i + 1i, 31i, (count - i - 1i) * 16i + 8i)
    i = i + 1i
  end
  a_stack(c, count * 16i, false)
  if n = "clock" or n = "sleep" or n = "sleep_until" then
    if n = "clock" then
      rtcall(c, "runtime.clock")
    end
    if n = "sleep" then
      rtcall(c, "runtime.sleep")
    end
    if n = "sleep_until" then
      rtcall(c, "runtime.sleep_until")
    end
    return
  end
  if n = "string_at" then
    unscale(c, 2i, argument_type(e, 1i))
    a_cmpi(c, 2i, 0i)
    rtcond(c, 11i, "error.bounds")
    a_mov(c, 1i, 2i)
    return
  end
  if n = "arg" then
    a_cmp(c, 0i, 19i)
    rtcond(c, 2i, "error.bounds")
    a_addshift(c, 9i, 20i, 0i, 3i)
    a_load(c, 0i, 9i, 0i)
    a_value(c, 1i, 0i)
    loop = fresh(c)
    done = fresh(c)
    label_here(c, loop)
    a_add(c, 9i, 0i, 1i)
    a_width(c, 10i, 9i, 1i, true)
    a_zero(c, 10i, done, false)
    a_addi(c, 1i, 1i, 1i)
    a_branch(c, loop, false)
    label_here(c, done)
    return
  end
  if n = "argc" or n = "envp" then
    reg = 19i
    if n = "envp" then
      reg = 21i
    end
    a_mov(c, 0i, reg)
    finish_intrinsic(c, e)
    return
  end
  if n = "float" then
    t = argument_type(e, 0i)
    if t != 7i then
      emit(c, 0x9E620000)
      if t = 0i then
        a_fconstant(c, 1i, 0x412e848000000000)
        a_fbinary(c, 0i, 0i, 1i, "/")
      end
      a_fmov(c, 0i, 0i, false)
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "float32_bits" then
    finite_value(c)
    a_fmov(c, 0i, 0i, true)
    emit(c, 0x1E624000) # FCVT S0,D0 (explicit rounding)
    emit(c, 0x1E260000) # FMOV W0,S0
    a_mov(c, 14i, 0i)
    emit(c, 0x1E22C000) # FCVT D0,S0
    a_fmov(c, 0i, 0i, false)
    finite_value(c)
    a_mov(c, 0i, 14i)
    finish_intrinsic(c, e)
    return
  end
  if n = "float32_from_bits" then
    unsigned_width(c, 0i, 4i)
    emit(c, 0x1E270000) # FMOV S0,W0
    emit(c, 0x1E22C000) # FCVT D0,S0
    a_fmov(c, 0i, 0i, false)
    finite_value(c)
    finish_intrinsic(c, e)
    return
  end
  if starts(n, "atomic_") then
    a_value(c, 3i, 8i)
    rtcall(c, "runtime.bounds")
    a_mov(c, 9i, 0i)
    a_value(c, 10i, 7i)
    a_op3(c, 0x8A000000, 10i, 9i, 10i)
    rtzero(c, 10i, "error.bounds", true)
    if n = "atomic_load" then
      emit(c, 0xC8DFFD20) # LDAR X0,[X9]
    end
    if n = "atomic_store" then
      emit(c, 0xC89FFD24) # STLR X4,[X9]
    end
    if n = "atomic_add" then
      loop = fresh(c)
      label_here(c, loop)
      emit(c, 0xC85FFD20) # LDAXR X0,[X9]
      a_add(c, 10i, 0i, 4i)
      emit(c, 0xC80BFD2A) # STLXR W11,X10,[X9]
      a_zero(c, 11i, loop, true)
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "float_bits" or n = "float_from_bits" then
    finish_intrinsic(c, e)
    return
  end
  if n = "sqrt" then
    a_fmov(c, 0i, 0i, true)
    emit(c, 0x1E61C000)
    a_fmov(c, 0i, 0i, false)
    finite_value(c)
    finish_intrinsic(c, e)
    return
  end
  if n = "trunc" or (n = "int" and argument_type(e, 0i) = 7i) then
    finite_value(c)
    a_fmov(c, 0i, 0i, true)
    a_fconstant(c, 1i, 0x43e0000000000000)
    a_fcmp(c, 0i, 1i)
    rtcond(c, 10i, "error.int_overflow")
    a_fconstant(c, 1i, 0xc3e0000000000000)
    a_fcmp(c, 0i, 1i)
    rtcond(c, 4i, "error.int_overflow")
    emit(c, 0x9E780000)
    if n = "int" then
      emit(c, 0x9E620001)
      a_fcmp(c, 0i, 1i)
      rtcond(c, 1i, "error.integer")
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "int" then
    unscale(c, 0i, argument_type(e, 0i))
    finish_intrinsic(c, e)
    return
  end
  if n = "number" then
    if argument_type(e, 0i) = 3i then
      to_number(c, 0i)
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "floor" or n = "ceil" or n = "abs" then
    t = get(e, 1i)
    if t = 7i then
      a_fmov(c, 0i, 0i, true)
      op = 0x1E60C000
      if n = "floor" then
        op = 0x1E654000
      end
      if n = "ceil" then
        op = 0x1E64C000
      end
      emit(c, op)
      a_fmov(c, 0i, 0i, false)
      finite_value(c)
    else
      done = fresh(c)
      if n = "abs" then
        a_cmpi(c, 0i, 0i)
        a_condition(c, 10i, done)
        a_neg(c, 0i, 0i, true)
        err = "error.overflow"
        if t = 3i then
          err = "error.int_overflow"
        end
        rtcond(c, 6i, err)
      else
        a_value(c, 9i, 1000000i)
        a_op3(c, 0x9AC00C00, 10i, 0i, 9i)
        a_msub(c, 11i, 10i, 9i, 0i)
        a_sub(c, 0i, 0i, 11i)
        a_cmpi(c, 11i, 0i)
        if n = "floor" then
          a_condition(c, 10i, done)
          a_op3(c, 0xEB000000, 0i, 0i, 9i)
        else
          a_condition(c, 13i, done)
          a_op3(c, 0xAB000000, 0i, 0i, 9i)
        end
        rtcond(c, 6i, "error.overflow")
      end
      label_here(c, done)
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "alloc" then
    unscale(c, 0i, argument_type(e, 0i))
    rtcall(c, "runtime.alloc")
    return
  end
  if n = "free" then
    rtcall(c, "runtime.free")
    finish_intrinsic(c, e)
    return
  end
  if n = "len" then
    if argument_type(e, 0i) = 4i then
      rtcall(c, "runtime.validate")
      a_mov(c, 0i, 9i)
    else
      a_mov(c, 0i, 1i)
    end
    to_number(c, 0i)
    finish_intrinsic(c, e)
    return
  end
  if n = "slice" then
    unscale(c, 2i, argument_type(e, 1i))
    unscale(c, 4i, argument_type(e, 2i))
    a_cmp(c, 2i, 1i)
    rtcond(c, 8i, "error.bounds")
    a_sub(c, 9i, 1i, 2i)
    a_cmp(c, 4i, 9i)
    rtcond(c, 8i, "error.bounds")
    a_add(c, 0i, 0i, 2i)
    a_mov(c, 1i, 4i)
    return
  end
  if n = "view" then
    unscale(c, 2i, argument_type(e, 1i))
    unscale(c, 4i, argument_type(e, 2i))
    a_mov(c, 3i, 4i)
    rtcall(c, "runtime.bounds")
    a_mov(c, 1i, 4i)
    return
  end
  if n = "copy" then
    unscale(c, 2i, argument_type(e, 1i))
    unscale(c, 6i, argument_type(e, 3i))
    unscale(c, 8i, argument_type(e, 4i))
    a_mov(c, 13i, 8i)
    a_mov(c, 3i, 13i)
    rtcall(c, "runtime.bounds")
    a_mov(c, 12i, 0i)
    a_mov(c, 0i, 4i)
    a_mov(c, 1i, 5i)
    a_mov(c, 2i, 6i)
    a_mov(c, 3i, 13i)
    if argument_type(e, 2i) = 4i then
      rtcall(c, "runtime.bounds")
    else
      a_cmp(c, 2i, 1i)
      rtcond(c, 8i, "error.bounds")
      a_sub(c, 9i, 1i, 2i)
      a_cmp(c, 3i, 9i)
      rtcond(c, 8i, "error.bounds")
      a_add(c, 0i, 0i, 2i)
    end
    done = fresh(c)
    forward = fresh(c)
    back = fresh(c)
    loop = fresh(c)
    a_zero(c, 13i, done, false)
    a_cmp(c, 12i, 0i)
    a_condition(c, 3i, forward)
    a_add(c, 0i, 0i, 13i)
    a_add(c, 12i, 12i, 13i)
    label_here(c, back)
    a_subi(c, 0i, 0i, 1i)
    a_subi(c, 12i, 12i, 1i)
    a_width(c, 14i, 0i, 1i, true)
    a_width(c, 14i, 12i, 1i, false)
    a_subi(c, 13i, 13i, 1i)
    a_zero(c, 13i, back, true)
    a_branch(c, done, false)
    label_here(c, forward)
    label_here(c, loop)
    a_width(c, 14i, 0i, 1i, true)
    a_width(c, 14i, 12i, 1i, false)
    a_addi(c, 0i, 0i, 1i)
    a_addi(c, 12i, 12i, 1i)
    a_subi(c, 13i, 13i, 1i)
    a_zero(c, 13i, loop, true)
    label_here(c, done)
    finish_intrinsic(c, e)
    return
  end
  if n = "char_at" or n = "byte_at" then
    unscale(c, 2i, argument_type(e, 1i))
    a_cmp(c, 2i, 1i)
    rtcond(c, 2i, "error.bounds")
    a_add(c, 0i, 0i, 2i)
    if n = "byte_at" then
      a_width(c, 0i, 0i, 1i, true)
      a_value(c, 1i, 0i)
    else
      a_value(c, 1i, 1i)
    end
    return
  end
  if n = "fill" or n = "fill32" or n = "fill64" or n = "fill_range" or n = "fill32_range" or n = "fill64_range" then
    width = 1i
    if n = "fill32" or n = "fill32_range" then
      width = 4i
    end
    if n = "fill64" or n = "fill64_range" then
      width = 8i
    end
    ranged = count = 4i
    if ranged then
      unscale(c, 2i, argument_type(e, 1i))
      unscale(c, 4i, argument_type(e, 2i))
      if width != 8i then
        unscale(c, 6i, argument_type(e, 3i))
        unsigned_width(c, 6i, width)
      end
      a_mov(c, 3i, 4i)
      rtcall(c, "runtime.bounds")
      a_mov(c, 8i, 0i)
      a_mov(c, 9i, 4i)
      a_mov(c, 2i, 6i)
    else
      if width != 8i then
        unscale(c, 2i, argument_type(e, 1i))
        unsigned_width(c, 2i, width)
      end
      rtcall(c, "runtime.validate")
    end
    if width > 1i then
      a_value(c, 10i, width - 1i)
      a_op3(c, 0x8A000000, 10i, 9i, 10i)
      rtzero(c, 10i, "error.bounds", true)
    end
    if get(c, 17i) != 0i and width < 8i then
      if width = 1i then
        a_value(c, 10i, 0x0101010101010101)
        a_op3(c, 0x9B007C00, 2i, 2i, 10i)
      else
        a_addshift(c, 2i, 2i, 2i, 32i)
      end
      wide_loop = fresh(c)
      wide_done = fresh(c)
      label_here(c, wide_loop)
      a_cmpi(c, 9i, 8i)
      a_condition(c, 3i, wide_done)
      a_width(c, 2i, 8i, 8i, false)
      a_addi(c, 8i, 8i, 8i)
      a_subi(c, 9i, 9i, 8i)
      a_branch(c, wide_loop, false)
      label_here(c, wide_done)
    end
    loop = fresh(c)
    done = fresh(c)
    a_zero(c, 9i, done, false)
    label_here(c, loop)
    a_width(c, 2i, 8i, width, false)
    a_addi(c, 8i, 8i, width)
    a_subi(c, 9i, 9i, width)
    a_zero(c, 9i, loop, true)
    label_here(c, done)
    finish_intrinsic(c, e)
    return
  end
  if n = "write_bytes" then
    unscale(c, 2i, argument_type(e, 1i))
    unscale(c, 4i, argument_type(e, 2i))
    a_mov(c, 3i, 4i)
    rtcall(c, "runtime.bounds")
    a_mov(c, 2i, 4i)
    a_mov(c, 1i, 0i)
    a_value(c, 0i, 1i)
    rtcall(c, "runtime.write")
    finish_intrinsic(c, e)
    return
  end
  if n = "address" then
    if argument_type(e, 0i) = 4i then
      rtcall(c, "runtime.validate")
      a_mov(c, 0i, 8i)
    end
    finish_intrinsic(c, e)
    return
  end
  if n = "pointer" or n = "address_int" then
    finish_intrinsic(c, e)
    return
  end
  if n = "offset" then
    unscale(c, 2i, argument_type(e, 1i))
    a_add(c, 0i, 0i, 2i)
    finish_intrinsic(c, e)
    return
  end
  if n = "band" or n = "bor" or n = "bxor" then
    op = 0x8A000000
    if n = "bor" then
      op = 0xAA000000
    end
    if n = "bxor" then
      op = 0xCA000000
    end
    a_op3(c, op, 0i, 0i, 2i)
    finish_intrinsic(c, e)
    return
  end
  if n = "bnot" then
    a_value(c, 9i, -1i)
    a_op3(c, 0xCA000000, 0i, 0i, 9i)
    finish_intrinsic(c, e)
    return
  end
  if n = "shl" or n = "shr" or n = "sar" then
    a_cmpi(c, 2i, 63i)
    rtcond(c, 8i, "error.shift")
    op = 0x9AC02000
    if n = "shr" then
      op = 0x9AC02400
    end
    if n = "sar" then
      op = 0x9AC02800
    end
    a_op3(c, op, 0i, 0i, 2i)
    finish_intrinsic(c, e)
    return
  end
  if n = "assert" then
    rtzero(c, 0i, "error.assert", false)
    finish_intrinsic(c, e)
    return
  end
  raw_access = starts(n, "peek") or starts(n, "poke")
  read = starts(n, "load") or starts(n, "peek")
  need(raw_access or starts(n, "load") or starts(n, "store"), "unimplemented compiler intrinsic")
  width = 1i
  if ends(n, "16") then
    width = 2i
  end
  if ends(n, "32") then
    width = 4i
  end
  if ends(n, "64") or ends(n, "num") or ends(n, "float") then
    width = 8i
  end
  if not read and width < 8i then
    reg = 4i
    arg = 2i
    if raw_access then
      reg = 2i
      arg = 1i
    end
    unscale(c, reg, argument_type(e, arg))
    unsigned_width(c, reg, width)
  end
  if not raw_access then
    unscale(c, 2i, argument_type(e, 1i))
    a_value(c, 3i, width)
    rtcall(c, "runtime.bounds")
  end
  if read then
    a_width(c, 0i, 0i, width, true)
    if width < 8i then
      to_number(c, 0i)
    end
  else
    reg = 4i
    if raw_access then
      reg = 2i
    end
    a_width(c, reg, 0i, width, false)
  end
  finish_intrinsic(c, e)
end
fn compare_condition(op: string, floating: bool): int
  if op = "=" then
    return 0i
  end
  if op = "!=" then
    return 1i
  end
  if op = "<" then
    if floating then
      return 4i
    end
    return 11i
  end
  if op = "<=" then
    if floating then
      return 9i
    end
    return 13i
  end
  if op = ">" then
    return 12i
  end
  return 10i
end
fn generate_expr(c: pointer, e: pointer): void
  k = get(e, 0i)
  t = get(e, 1i)
  if k = 0i or k = 2i then
    a_value(c, 0i, get(e, 3i))
    a_value(c, 1i, 0i)
    return
  end
  if k = 1i then
    text = gets(e, 4i)
    a_address(c, 0i, text_label(c, text))
    a_value(c, 1i, int(len(text)))
    return
  end
  if k = 7i then
    a_address(c, 0i, get(getp(e, 12i), 12i))
    a_value(c, 1i, 0i)
    return
  end
  if k = 3i then
    load_slot(c, get(e, 6i))
    return
  end
  if k = 6i then
    args = getp(e, 9i)
    if args != nil() then
      item = getp(args, 0i)
      while item != nil() do
        generate_expr(c, getp(item, 0i))
        push_value(c)
        item = getp(item, 1i)
      end
    end
    f = getp(e, 12i)
    if f != nil() then
      a_addi(c, 8i, 31i, 0i)
      a_branch(c, get(f, 9i), true)
      a_stack(c, get(e, 10i) * 16i, false)
    else
      intrinsic(c, e)
    end
    return
  end
  op = gets(e, 4i)
  if k = 4i then
    generate_expr(c, getp(e, 7i))
    if op = "-" then
      if t = 7i then
        a_value(c, 9i, 0x8000000000000000)
        a_op3(c, 0xCA000000, 0i, 0i, 9i)
      else
        a_neg(c, 0i, 0i, true)
        error = "error.overflow"
        if t = 3i then
          error = "error.int_overflow"
        end
        rtcond(c, 6i, error)
      end
    end
    if op = "not" then
      a_cmpi(c, 0i, 0i)
      a_cset(c, 0i, 0i)
    end
    a_value(c, 1i, 0i)
    return
  end
  need(k = 5i, "unknown AST expression")
  if op = "and" or op = "or" then
    done = fresh(c)
    generate_expr(c, getp(e, 7i))
    a_zero(c, 0i, done, op = "or")
    generate_expr(c, getp(e, 8i))
    label_here(c, done)
    a_value(c, 1i, 0i)
    return
  end
  right = getp(e, 8i)
  rk = get(right, 0i)
  scalar_type = get(getp(e, 7i), 1i)
  if get(c, 17i) != 0i and (rk = 0i or rk = 2i) and scalar_type != 7i and scalar_type != 1i then
    immediate = get(right, 3i)
    if immediate >= 0i and immediate <= 4095i then
      if op = "+" or op = "-" or op = "=" or op = "!=" or op = "<" or op = "<=" or op = ">" or op = ">=" then
        generate_expr(c, getp(e, 7i))
        if op = "+" or op = "-" then
          instruction = 0xB1000000
          if op = "-" then
            instruction = 0xF1000000
          end
          emit(c, bor(instruction, shl(immediate, 10i)))
          overflow = "error.overflow"
          if scalar_type = 3i then
            overflow = "error.int_overflow"
          end
          rtcond(c, 6i, overflow)
        else
          a_cmpi(c, 0i, immediate)
          a_cset(c, 0i, compare_condition(op, false))
        end
        a_value(c, 1i, 0i)
        return
      end
    end
  end
  generate_expr(c, getp(e, 7i))
  if get(c, 17i) != 0i and (rk = 0i or rk = 2i or rk = 3i) then
    a_mov(c, 2i, 0i)
    a_mov(c, 3i, 1i)
    generate_expr(c, right)
  else
    push_value(c)
    generate_expr(c, right)
    pop_left(c)
  end
  operand_type = get(getp(e, 7i), 1i)
  if operand_type = 7i then
    a_fmov(c, 0i, 0i, true)
    a_fmov(c, 1i, 2i, true)
    if op = "+" or op = "-" or op = "*" or op = "/" then
      if op = "/" then
        a_fconstant(c, 2i, 0i)
        a_fcmp(c, 0i, 2i)
        rtcond(c, 0i, "error.zero")
      end
      a_fbinary(c, 0i, 1i, 0i, op)
      a_fmov(c, 0i, 0i, false)
      finite_value(c)
    else
      a_fcmp(c, 1i, 0i)
      a_cset(c, 0i, compare_condition(op, true))
    end
    a_value(c, 1i, 0i)
    return
  end
  error = "error.overflow"
  if t = 3i then
    error = "error.int_overflow"
  end
  if op = "+" or op = "-" then
    opcode = 0xAB000000
    if op = "-" then
      opcode = 0xEB000000
    end
    a_op3(c, opcode, 0i, 2i, 0i)
    rtcond(c, 6i, error)
  else
    if op = "%" then
      rtzero(c, 0i, "error.zero", false)
      a_op3(c, 0x9AC00C00, 9i, 2i, 0i)
      a_msub(c, 0i, 9i, 0i, 2i)
    else
      if op = "*" then
        if t = 3i then
          a_op3(c, 0x9B407C00, 9i, 2i, 0i)
          a_op3(c, 0x9B007C00, 0i, 2i, 0i)
          a_right(c, 10i, 0i, 63i, true)
          a_cmp(c, 9i, 10i)
          rtcond(c, 1i, error)
        else
          rtcall(c, "runtime.multiply")
        end
      else
        if op = "/" then
          if t = 3i then
            rtzero(c, 0i, "error.zero", false)
            ok = fresh(c)
            a_value(c, 9i, 0x8000000000000000)
            a_cmp(c, 2i, 9i)
            a_condition(c, 1i, ok)
            a_value(c, 9i, -1i)
            a_cmp(c, 0i, 9i)
            rtcond(c, 0i, error)
            label_here(c, ok)
            a_op3(c, 0x9AC00C00, 0i, 2i, 0i)
          else
            rtcall(c, "runtime.divide")
          end
        else
          if operand_type = 1i then
            rtcall(c, "runtime.string_equal")
            if op = "!=" then
              a_cmpi(c, 0i, 0i)
              a_cset(c, 0i, 0i)
            end
          else
            a_cmp(c, 2i, 0i)
            a_cset(c, 0i, compare_condition(op, false))
          end
        end
      end
    end
  end
  a_value(c, 1i, 0i)
end
fn exit_code(c: pointer, code: int): void
  a_value(c, 0i, code)
  a_value(c, 16i, 1i)
  emit(c, 0xD4001001)
  emit(c, 0xD4200000)
end
fn generate_print(c: pointer, e: pointer): void
  generate_expr(c, e)
  t = get(e, 1i)
  if t = 0i then
    rtcall(c, "runtime.number")
  end
  if t = 3i then
    rtcall(c, "runtime.integer_print")
  end
  if t = 5i then
    rtcall(c, "runtime.pointer_print")
  end
  if t = 7i then
    rtcall(c, "runtime.float_print")
  end
  if t = 1i then
    write_value(c)
  end
  if t = 2i then
    no = fresh(c)
    done = fresh(c)
    a_zero(c, 0i, no, false)
    a_address(c, 0i, text_label(c, "true"))
    a_value(c, 1i, 4i)
    a_branch(c, done, false)
    label_here(c, no)
    a_address(c, 0i, text_label(c, "false"))
    a_value(c, 1i, 5i)
    label_here(c, done)
    write_value(c)
  end
end
fn loop_push(c: pointer, next: int, done: int): void
  loop = arena(c, 32i)
  put(loop, 0i, next)
  put(loop, 1i, done)
  putp(loop, 2i, getp(c, 15i))
  putp(c, 15i, loop)
end
fn loop_pop(c: pointer): void
  putp(c, 15i, getp(getp(c, 15i), 2i))
end
fn generate_block(c: pointer, body: pointer): void
  s = body
  while s != nil() do
    k = get(s, 0i)
    if k = 0i then
      generate_expr(c, getp(s, 4i))
      store_slot(c, get(s, 2i))
    end
    if k = 1i then
      it = getp(getp(s, 5i), 0i)
      while it != nil() do
        generate_print(c, getp(it, 0i))
        it = getp(it, 1i)
      end
    end
    if k = 2i then
      no = fresh(c)
      done = fresh(c)
      generate_expr(c, getp(s, 4i))
      a_zero(c, 0i, no, false)
      generate_block(c, getp(s, 7i))
      a_branch(c, done, false)
      label_here(c, no)
      generate_block(c, getp(s, 8i))
      label_here(c, done)
    end
    if k = 4i then
      head = fresh(c)
      done = fresh(c)
      label_here(c, head)
      generate_expr(c, getp(s, 4i))
      a_zero(c, 0i, done, false)
      loop_push(c, head, done)
      generate_block(c, getp(s, 7i))
      loop_pop(c)
      a_branch(c, head, false)
      label_here(c, done)
    end
    if k = 3i then
      it = getp(getp(s, 5i), 0i)
      i = 0i
      while it != nil() do
        generate_expr(c, getp(it, 0i))
        store_slot(c, get(s, 10i) + i)
        it = getp(it, 1i)
        i = i + 1i
      end
      a_value(c, 0i, 0i)
      a_value(c, 1i, 0i)
      store_slot(c, get(s, 9i))
      head = fresh(c)
      done = fresh(c)
      next = fresh(c)
      label_here(c, head)
      a_load(c, 9i, 28i, get(s, 9i) * 16i)
      a_value(c, 10i, get(s, 6i))
      a_cmp(c, 9i, 10i)
      a_condition(c, 2i, done)
      a_value(c, 10i, get(s, 10i) * 16i)
      a_add(c, 10i, 28i, 10i)
      a_addshift(c, 10i, 10i, 9i, 4i)
      a_load(c, 0i, 10i, 0i)
      a_load(c, 1i, 10i, 8i)
      store_slot(c, get(s, 2i))
      loop_push(c, next, done)
      generate_block(c, getp(s, 7i))
      loop_pop(c)
      label_here(c, next)
      a_load(c, 0i, 28i, get(s, 9i) * 16i)
      a_addi(c, 0i, 0i, 1i)
      a_store(c, 0i, 28i, get(s, 9i) * 16i)
      a_branch(c, head, false)
      label_here(c, done)
    end
    if k = 5i then
      e = getp(s, 4i)
      generate_expr(c, e)
      a_cmpi(c, 0i, 0i)
      rtcond(c, 11i, "error.exit")
      scale = 1000000i
      if get(e, 1i) = 3i then
        scale = 1i
      end
      a_value(c, 9i, 255i * scale)
      a_cmp(c, 0i, 9i)
      rtcond(c, 8i, "error.exit")
      a_value(c, 9i, scale)
      a_op3(c, 0x9AC00800, 10i, 0i, 9i)
      a_msub(c, 11i, 10i, 9i, 0i)
      rtzero(c, 11i, "error.exit", true)
      a_mov(c, 0i, 10i)
      a_value(c, 16i, 1i)
      emit(c, 0xD4001001)
      emit(c, 0xD4200000)
    end
    if k = 6i then
      generate_expr(c, getp(s, 4i))
    end
    if k = 7i then
      generate_block(c, getp(s, 7i))
    end
    if k = 8i then
      if getp(s, 4i) != nil() then
        generate_expr(c, getp(s, 4i))
      else
        a_value(c, 0i, 0i)
        a_value(c, 1i, 0i)
      end
      a_branch(c, get(c, 14i), false)
    end
    if k = 9i then
      a_branch(c, get(getp(c, 15i), 1i), false)
    end
    if k = 10i then
      a_branch(c, get(getp(c, 15i), 0i), false)
    end
    s = getp(s, 11i)
  end
end
fn generate_function(c: pointer, f: pointer): void
  label_here(c, get(f, 9i))
  a_stack(c, 32i, true)
  a_store(c, 29i, 31i, 0i)
  a_store(c, 30i, 31i, 8i)
  a_store(c, 28i, 31i, 16i)
  a_addi(c, 29i, 31i, 0i)
  a_stack(c, get(f, 7i) * 16i, true)
  a_addi(c, 28i, 31i, 0i)
  a_cmp(c, 28i, 22i)
  rtcond(c, 3i, "error.stack")
  count = get(f, 5i)
  i = 0i
  while i < count do
    a_load(c, 0i, 8i, (count - i - 1i) * 16i)
    a_load(c, 1i, 8i, (count - i - 1i) * 16i + 8i)
    store_slot(c, get(list_get(getp(f, 4i), i), 3i))
    i = i + 1i
  end
  endlabel = fresh(c)
  put(c, 14i, endlabel)
  generate_block(c, getp(f, 6i))
  a_value(c, 0i, 0i)
  a_value(c, 1i, 0i)
  label_here(c, endlabel)
  a_addi(c, 31i, 29i, 0i)
  a_load(c, 28i, 31i, 16i)
  a_load(c, 30i, 31i, 8i)
  a_load(c, 29i, 31i, 0i)
  a_stack(c, 32i, false)
  emit(c, 0xD65F03C0)
end
fn emit_time_init(c: pointer): void
  a_stack(c, 16i, true)
  a_addi(c, 0i, 31i, 0i)
  a_value(c, 16i, -89i)
  emit(c, 0xD4001001)
  rtzero(c, 0i, "error.time", true)
  a_width(c, 25i, 31i, 4i, true)
  a_addi(c, 9i, 31i, 4i)
  a_width(c, 24i, 9i, 4i, true)
  a_stack(c, 16i, false)
  rtzero(c, 25i, "error.time", false)
  rtzero(c, 24i, "error.time", false)
  a_value(c, 9i, 1000i)
  a_op3(c, 0x9B007C00, 24i, 24i, 9i)
  rtcall(c, "runtime.rawclock")
  a_mov(c, 23i, 0i)
end
fn generate_task_adapter(c: pointer, f: pointer): void
  label_here(c, get(f, 12i))
  # Native ABI entry: X0 envelope, X1 lane. Preserve all required callee-saved state.
  a_stack(c, 208i, true)
  reg = 19i
  while reg <= 30i do
    a_store(c, reg, 31i, 48i + (reg - 19i) * 8i)
    reg = reg + 1i
  end
  reg = 8i
  while reg <= 15i do
    emit(c, 0xFD000000 + ((144i + (reg - 8i) * 8i) / 8i) * 1024i + 31i * 32i + reg)
    reg = reg + 1i
  end
  a_mov(c, 19i, 0i)
  a_mov(c, 20i, 1i)
  a_load(c, 27i, 19i, 16i)
  a_load(c, 10i, 19i, 24i)
  a_load(c, 11i, 19i, 32i)
  a_op3(c, 0x9AC00800, 12i, 10i, 11i) # quotient
  a_msub(c, 13i, 12i, 11i, 10i) # remainder
  a_op3(c, 0x9B007C00, 14i, 20i, 12i)
  full = fresh(c)
  ready = fresh(c)
  a_cmp(c, 20i, 13i)
  a_condition(c, 2i, full)
  a_add(c, 14i, 14i, 20i)
  a_add(c, 15i, 14i, 12i)
  a_addi(c, 15i, 15i, 1i)
  a_branch(c, ready, false)
  label_here(c, full)
  a_add(c, 14i, 14i, 13i)
  a_add(c, 15i, 14i, 12i)
  label_here(c, ready)
  a_store(c, 15i, 31i, 0i)
  a_store(c, 31i, 31i, 8i)
  a_store(c, 14i, 31i, 16i)
  a_store(c, 31i, 31i, 24i)
  a_load(c, 9i, 19i, 0i)
  a_store(c, 9i, 31i, 32i)
  a_load(c, 9i, 19i, 8i)
  a_store(c, 9i, 31i, 40i)
  a_addi(c, 22i, 31i, 0i)
  a_value(c, 9i, 131072i)
  a_sub(c, 22i, 22i, 9i)
  a_addi(c, 8i, 31i, 0i)
  a_branch(c, get(f, 9i), true)
  reg = 8i
  while reg <= 15i do
    emit(c, 0xFD400000 + ((144i + (reg - 8i) * 8i) / 8i) * 1024i + 31i * 32i + reg)
    reg = reg + 1i
  end
  reg = 19i
  while reg <= 30i do
    a_load(c, reg, 31i, 48i + (reg - 19i) * 8i)
    reg = reg + 1i
  end
  a_stack(c, 208i, false)
  emit(c, 0xD65F03C0)
end

fn generate(p: pointer): pointer
  c = new_arena(33554432i, 256i)
  put(c, 17i, 1i - get(p, 24i))
  putp(c, 18i, raw(8192i))
  putp(c, 3i, raw(33554432i))
  putp(c, 6i, raw(2097152i))
  emit_runtime(c)
  f = getp(p, 8i)
  while f != nil() do
    put(f, 9i, fresh(c))
    if get(f, 11i) = 1i then
      put(f, 12i, fresh(c))
    end
    f = getp(f, 8i)
  end
  label_here(c, runtime_id("program.entry"))
  emit(c, 0x2A0003F3) # argc: clear upper 32 bits as required for a C int argument.
  a_mov(c, 20i, 1i)
  a_mov(c, 21i, 2i)
  a_stack(c, 32i, true)
  a_store(c, 29i, 31i, 0i)
  a_store(c, 30i, 31i, 8i)
  a_store(c, 28i, 31i, 16i)
  a_addi(c, 29i, 31i, 0i)
  a_value(c, 27i, 0i)
  a_addi(c, 22i, 31i, 0i)
  a_value(c, 17i, 1048576i)
  a_sub(c, 22i, 22i, 17i)
  if get(p, 12i) != 0i then
    emit_time_init(c)
  end
  a_stack(c, get(p, 11i) * 16i, true)
  a_addi(c, 28i, 31i, 0i)
  generate_block(c, getp(p, 10i))
  exit_code(c, 0i)
  f = getp(p, 8i)
  while f != nil() do
    generate_function(c, f)
    if get(f, 11i) = 1i then
      generate_task_adapter(c, f)
    end
    f = getp(f, 8i)
  end
  finish_code(c)
  return c
end
# SHA-256: explicit 32-bit masking on APO's checked 64-bit integers.
# One reusable workspace avoids one-allocation-per-hashed-page leaks.
fn ror32(x: int, n: int): int
  return band(bor(shr(x, n), shl(x, 32i - n)), 0xffffffff)
end
fn read_be32(p: pointer, pos: int): int
  return shl(getb(p, pos), 24i) + shl(getb(p, pos + 1i), 16i) + shl(getb(p, pos + 2i), 8i) + getb(p, pos + 3i)
end
fn write_be32(p: pointer, pos: int, value: int): void
  setb(p, pos, band(shr(value, 24i), 255i))
  setb(p, pos + 1i, band(shr(value, 16i), 255i))
  setb(p, pos + 2i, band(shr(value, 8i), 255i))
  setb(p, pos + 3i, band(value, 255i))
end
fn sha_workspace(): pointer
  p = raw(1216i)
  i = 0i
  for value in 0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5 0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174 0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da 0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967 0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85 0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070 0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3 0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2
    put(at(p, 576i), i, value)
    i = i + 1i
  end
  return p
end
fn sha_block(state: pointer, block: pointer): void
  w = at(state, 64i)
  k = at(state, 576i)
  i = 0i
  while i < 16i do
    put(w, i, read_be32(block, i * 4i))
    i = i + 1i
  end
  while i < 64i do
    u = get(w, i - 15i)
    v = get(w, i - 2i)
    s0 = bxor(bxor(ror32(u, 7i), ror32(u, 18i)), shr(u, 3i))
    s1 = bxor(bxor(ror32(v, 17i), ror32(v, 19i)), shr(v, 10i))
    put(w, i, band(get(w, i - 16i) + s0 + get(w, i - 7i) + s1, 0xffffffff))
    i = i + 1i
  end
  a = get(state, 0i)
  b = get(state, 1i)
  c = get(state, 2i)
  d = get(state, 3i)
  e = get(state, 4i)
  f = get(state, 5i)
  g = get(state, 6i)
  h = get(state, 7i)
  i = 0i
  while i < 64i do
    s1 = bxor(bxor(ror32(e, 6i), ror32(e, 11i)), ror32(e, 25i))
    choose = bxor(band(e, f), band(bnot(e), g))
    t1 = h + s1 + choose + get(k, i) + get(w, i)
    s0 = bxor(bxor(ror32(a, 2i), ror32(a, 13i)), ror32(a, 22i))
    majority = bxor(bxor(band(a, b), band(a, c)), band(b, c))
    t2 = s0 + majority
    h = g
    g = f
    f = e
    e = band(d + t1, 0xffffffff)
    d = c
    c = b
    b = a
    a = band(t1 + t2, 0xffffffff)
    i = i + 1i
  end
  put(state, 0i, band(get(state, 0i) + a, 0xffffffff))
  put(state, 1i, band(get(state, 1i) + b, 0xffffffff))
  put(state, 2i, band(get(state, 2i) + c, 0xffffffff))
  put(state, 3i, band(get(state, 3i) + d, 0xffffffff))
  put(state, 4i, band(get(state, 4i) + e, 0xffffffff))
  put(state, 5i, band(get(state, 5i) + f, 0xffffffff))
  put(state, 6i, band(get(state, 6i) + g, 0xffffffff))
  put(state, 7i, band(get(state, 7i) + h, 0xffffffff))
end
fn sha256(state: pointer, data: pointer, size: int, result: pointer): void
  need(size >= 0i and size <= 33554432i, "SHA-256 input limit")
  i = 0i
  for value in 0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19
    put(state, i, value)
    i = i + 1i
  end
  pos = 0i
  while size - pos >= 64i do
    sha_block(state, at(data, pos))
    pos = pos + 64i
  end
  tail = at(state, 1088i)
  i = 0i
  while i < 16i do
    put(tail, i, 0i)
    i = i + 1i
  end
  rest = size - pos
  raw_copy(tail, at(data, pos), rest)
  setb(tail, rest, 128i)
  tail_size = 64i
  if rest >= 56i then
    tail_size = 128i
  end
  write_be32(tail, tail_size - 8i, shr(size * 8i, 32i))
  write_be32(tail, tail_size - 4i, band(size * 8i, 0xffffffff))
  sha_block(state, tail)
  if tail_size = 128i then
    sha_block(state, at(tail, 64i))
  end
  i = 0i
  while i < 8i do
    write_be32(result, i * 4i, get(state, i))
    i = i + 1i
  end
end
# Mach-O writer. These are file bytes, not a call to a system linker or signer.
fn aligned(n: int, alignment: int): int
  return band(n + alignment - 1i, bnot(alignment - 1i))
end
fn writer(data: pointer, limit: int, pos: int): pointer
  w = raw(32i)
  putp(w, 0i, data)
  put(w, 1i, limit)
  put(w, 2i, pos)
  return w
end
fn wreserve(w: pointer, count: int): pointer
  pos = get(w, 2i)
  need(pos >= 0i and count >= 0i and pos <= get(w, 1i) - count, "binary writer overflow")
  put(w, 2i, pos + count)
  return at(getp(w, 0i), pos)
end
fn w32(w: pointer, value: int): void
  unsafe
    poke32(wreserve(w, 4i), value)
  end
end
fn w64(w: pointer, value: int): void
  unsafe
    poke64(wreserve(w, 8i), value)
  end
end
fn wb32(w: pointer, value: int): void
  write_be32(wreserve(w, 4i), 0i, value)
end
fn wb64(w: pointer, value: int): void
  wb32(w, shr(value, 32i))
  wb32(w, band(value, 0xffffffff))
end
fn wtext(w: pointer, text: string): void
  unsafe
    raw_copy(wreserve(w, int(len(text))), address(text), int(len(text)))
  end
end
fn wname(w: pointer, text: string): void
  need(int(len(text)) <= 16i, "Mach-O name too long")
  p = wreserve(w, 16i)
  unsafe
    raw_copy(p, address(text), int(len(text)))
  end
end
fn segment(w: pointer, name: string, address_value: int, memory_size: int, file_offset: int, file_size: int, protection: int, sections: int): void
  w32(w, 0x19)
  w32(w, 72i + sections * 80i)
  wname(w, name)
  w64(w, address_value)
  w64(w, memory_size)
  w64(w, file_offset)
  w64(w, file_size)
  w32(w, protection)
  w32(w, protection)
  w32(w, sections)
  w32(w, 0i)
end
fn section(w: pointer, name: string, pos: int, size: int, alignment: int, flags: int): void
  wname(w, name)
  wname(w, "__TEXT")
  w64(w, 0x100000000 + pos)
  w64(w, size)
  w32(w, pos)
  w32(w, alignment)
  w32(w, 0i)
  w32(w, 0i)
  w32(w, flags)
  w32(w, 0i)
  w32(w, 0i)
  w32(w, 0i)
end
fn path_command(w: pointer, command: int, path: string, library: bool): void
  name_offset = 12i
  if library then
    name_offset = 24i
  end
  size = aligned(name_offset + int(len(path)) + 1i, 8i)
  start = get(w, 2i)
  w32(w, command)
  w32(w, size)
  w32(w, name_offset)
  if library then
    w32(w, 0i)
    w32(w, 0x10000)
    w32(w, 0x10000)
  end
  wtext(w, path)
  wreserve(w, start + size - get(w, 2i))
end
fn macho(c: pointer): pointer
  payload_size = get(c, 13i)
  code_size = get(c, 11i)
  string_pos = get(c, 12i)
  need(code_size > 0i and code_size % 4i = 0i and string_pos = aligned(code_size, 16i) and payload_size >= string_pos, "invalid native payload")
  text_size = aligned(4096i + payload_size, 16384i)
  linked = get(c, 25i) != 0i or get(c, 26i) != 0i
  link_start = text_size
  if linked then
    link_start = link_start + 16384i
  end
  # Eager dyld binding into a dedicated writable non-executable __DATA page.
  bind_info = raw(32i)
  if linked then
    # SET_DYLIB_ORDINAL_IMM(1), SET_TYPE_IMM(pointer), SET_SYMBOL, SEGMENT(2).
    setb(bind_info, 0i, 17i)
    setb(bind_info, 1i, 81i)
    setb(bind_info, 2i, 64i)
    unsafe
      raw_copy(at(bind_info, 3i), address("_dlopen\0"), 8i)
    end
    setb(bind_info, 11i, 114i)
    setb(bind_info, 12i, 0i)
    setb(bind_info, 13i, 144i)
    setb(bind_info, 14i, 64i)
    unsafe
      raw_copy(at(bind_info, 15i), address("_dlsym\0"), 7i)
    end
    setb(bind_info, 22i, 144i)
    setb(bind_info, 23i, 0i)
  end
  sig_pos = link_start + 16i
  if linked then
    sig_pos = link_start + 128i
  end
  slots = (sig_pos + 4095i) / 4096i
  identifier = "apo.executable\0"
  hash_offset = 88i + int(len(identifier))
  directory_size = hash_offset + slots * 32i
  sig_size = aligned(20i + directory_size, 16i)
  file_size = sig_pos + sig_size
  need(file_size < 67108864i, "executable limit exceeded")
  image = raw(file_size)
  w = writer(image, 4096i, 32i)
  segment(w, "__PAGEZERO", 0i, 0x100000000, 0i, 0i, 0i, 0i)
  segment(w, "__TEXT", 0x100000000, text_size, 0i, text_size, 5i, 2i)
  section(w, "__text", 4096i, code_size, 2i, 0x80000400)
  section(w, "__cstring", 4096i + string_pos, payload_size - string_pos, 4i, 2i)
  if linked then
    segment(w, "__DATA", 0x100000000 + text_size, 16384i, text_size, 16384i, 3i, 1i)
    wname(w, "__got")
    wname(w, "__DATA")
    w64(w, 0x100000000 + text_size)
    w64(w, 16i)
    w32(w, text_size)
    w32(w, 3i)
    w32(w, 0i)
    w32(w, 0i)
    w32(w, 6i) # S_NON_LAZY_SYMBOL_POINTERS
    w32(w, 0i)
    w32(w, 0i)
    w32(w, 0i)
  end
  segment(w, "__LINKEDIT", 0x100000000 + link_start, aligned(file_size - link_start, 16384i), link_start, file_size - link_start, 1i, 0i)
  w32(w, 0x80000022)
  w32(w, 48i)
  i = 0i
  while i < 10i do
    value = 0i
    if linked and i = 2i then
      value = link_start
    end
    if linked and i = 3i then
      value = 24i
    end
    w32(w, value)
    i = i + 1i
  end
  w32(w, 2i)
  w32(w, 24i)
  if linked then
    w32(w, link_start + 32i) # nlist_64 table
    w32(w, 2i)
    w32(w, link_start + 80i) # string table
    w32(w, 16i)
  else
    w32(w, link_start)
    w32(w, 0i)
    w32(w, link_start)
    w32(w, 1i)
  end
  w32(w, 11i)
  w32(w, 80i)
  i = 0i
  while i < 18i do
    value = 0i
    if linked and i = 5i then
      value = 2i # nundefsym
    end
    if linked and i = 12i then
      value = link_start + 64i # indirectsymoff
    end
    if linked and i = 13i then
      value = 2i # nindirectsyms
    end
    w32(w, value)
    i = i + 1i
  end
  path_command(w, 14i, "/usr/lib/dyld", false)
  sha = sha_workspace()
  digest = raw(32i)
  sha256(sha, getp(c, 3i), payload_size, digest)
  w32(w, 27i)
  w32(w, 24i)
  raw_copy(wreserve(w, 16i), digest, 16i)
  w32(w, 50i)
  w32(w, 24i)
  w32(w, 1i)
  w32(w, 0x000b0000)
  w32(w, 0x000b0000)
  w32(w, 0i)
  w32(w, 0x80000028)
  w32(w, 24i)
  w64(w, 4096i)
  w64(w, 8388608i)
  path_command(w, 12i, "/usr/lib/libSystem.B.dylib", true)
  w32(w, 29i)
  w32(w, 16i)
  w32(w, sig_pos)
  w32(w, sig_size)
  command_size = get(w, 2i) - 32i
  put(w, 2i, 0i)
  w32(w, 0xfeedfacf)
  w32(w, 0x0100000c)
  w32(w, 0i)
  w32(w, 2i)
  if linked then
    w32(w, 13i)
  else
    w32(w, 12i)
  end
  w32(w, command_size)
  w32(w, 0x00200085)
  w32(w, 0i)
  raw_copy(at(image, 4096i), getp(c, 3i), payload_size)
  if linked then
    raw_copy(at(image, link_start), bind_info, 24i)
    # nlist entries: N_UNDF|N_EXT, library ordinal 1, no preferred address.
    unsafe
      poke32(at(image, link_start + 32i), 1i)
      poke32(at(image, link_start + 36i), 0x01000001)
      poke32(at(image, link_start + 48i), 9i)
      poke32(at(image, link_start + 52i), 0x01000001)
      poke32(at(image, link_start + 64i), 0i)
      poke32(at(image, link_start + 68i), 1i)
      raw_copy(at(image, link_start + 80i), address("\0_dlopen\0_dlsym\0"), 16i)
    end
  end
  put(w, 1i, file_size)
  put(w, 2i, sig_pos)
  wb32(w, 0xfade0cc0)
  wb32(w, 20i + directory_size)
  wb32(w, 1i)
  wb32(w, 0i)
  wb32(w, 20i)
  wb32(w, 0xfade0c02)
  wb32(w, directory_size)
  wb32(w, 0x20400)
  wb32(w, 0x20002)
  wb32(w, hash_offset)
  wb32(w, 88i)
  wb32(w, 0i)
  wb32(w, slots)
  wb32(w, sig_pos)
  wb32(w, 0x2002000c)
  wb32(w, 0i)
  wb32(w, 0i)
  wb32(w, 0i)
  wb32(w, 0i)
  wb64(w, 0i)
  wb64(w, 0i)
  wb64(w, text_size)
  wb64(w, 1i)
  wtext(w, identifier)
  pos = 0i
  while pos < sig_pos do
    sha256(sha, at(image, pos), minint(4096i, sig_pos - pos), wreserve(w, 32i))
    pos = pos + 4096i
  end
  put(c, 16i, file_size)
  return image
end
# Command-line interface, filesystem I/O, launching: all compiled APO.
fn usage(): void
  print: "APO 2.1.5 - self-hosted native macOS ARM64 compiler\n"
  print: "  apo build source.apo [-o executable] [--dump] [--no-opt]\n"
  print: "  apo check source.apo\n"
  print: "  apo run source.apo [-- program arguments...]\n"
  print: "  apo --version\n"
  print: "Named imports: use window. Override library root with --lib-dir or APO_LIB.\n"
  print: "Default output: out/<source basename>. No external compiler is invoked.\n"
end
fn default_output(source: string): string
  pos = 0i
  base = 0i
  while pos < int(len(source)) do
    if byte_at(source, pos) = 47i then
      base = pos + 1i
    end
    pos = pos + 1i
  end
  stem = slice(source, base, int(len(source)) - base - 4i)
  if int(len(stem)) = 0i then
    die("source must have a basename before .apo", 64i)
  end
  return concat("out/", stem)
end
fn dump_code(c: pointer): void
  pos = 0i
  while pos < get(c, 11i) do
    unsafe
      print: pointer(pos), "  ", pointer(int(peek32(at(getp(c, 3i), pos)))), \nl
    end
    pos = pos + 4i
  end
end
fn launch(path: string, first_arg: int): void
  count = argc() - first_arg
  need(count >= 0i and count <= 512i, "too many program arguments")
  argv = raw((count + 2i) * 8i)
  pathbuf = cstring(path)
  unsafe
    putp(argv, 0i, address(pathbuf))
    i = 0i
    while i < count do
      # argv strings remain allocated until exec replaces this process.
      text = cstring(arg(first_arg + i))
      putp(argv, i + 1i, address(text))
      i = i + 1i
    end
    result = syscall(59i, address(pathbuf), argv, envp(), 0i, 0i, 0i)
    write_fd(2i, concat("execve failed, errno ", strint(-result)))
    die("cannot launch executable", 74i)
  end
end
fn driver(): void
  if argc() < 2i then
    usage()
    return
  end
  mode = arg(1i)
  if mode = "--version" then
    print: "APO 2.1.5 (self-hosted, macOS arm64)", \nl
    return
  end
  if mode = "--help" or mode = "help" then
    usage()
    return
  end
  if mode != "build" and mode != "check" and mode != "run" then
    die("expected build, check, run, or --help", 64i)
  end
  if argc() < 3i then
    die("missing .apo source path", 64i)
  end
  source = arg(2i)
  if not apo_suffix(source) then
    die("source filename must end in .apo", 64i)
  end
  output = default_output(source)
  dump = false
  no_opt = false
  libraries = library_root()
  first_arg = argc()
  i = 3i
  while i < argc() do
    option = arg(i)
    if option = "--" and mode = "run" then
      first_arg = i + 1i
      break
    end
    if option = "--lib-dir" then
      i = i + 1i
      if i >= argc() or arg(i) = "" then
        die("--lib-dir requires a directory", 64i)
      end
      libraries = path_normal(arg(i))
      i = i + 1i
      continue
    end
    if option = "--no-opt" then
      no_opt = true
      i = i + 1i
      continue
    end
    if option = "-o" and mode = "build" then
      i = i + 1i
      if i >= argc() then
        die("missing output path after -o", 64i)
      end
      output = arg(i)
    else
      if option = "--dump" and mode = "build" then
        dump = true
      else
        die(concat("unexpected option: ", option), 64i)
      end
    end
    i = i + 1i
  end
  # Validate before path normalization; an empty -o is a usage error.
  if int(len(output)) = 0i or int(len(output)) >= 4096i then
    die("output path must contain 1..4095 bytes", 64i)
  end
  normalized_output = path_normal(output)
  if normalized_output = "." or normalized_output = ".." or normalized_output = "/" then
    die("output must name a file, not a directory", 64i)
  end
  # Do not let an innocent typo replace a source file with machine code.
  if apo_suffix(output) or normalized_output = path_normal(source) or normalized_output = path_normal(arg(0i)) then
    die("refusing to overwrite a source file or the running compiler", 64i)
  end
  p = parse(load_program(source, libraries), source)
  if no_opt then
    put(p, 24i, 1i)
  end
  if mode = "check" then
    print: "Checked ", source, \nl
    return
  end
  c = generate(p)
  image = macho(c)
  save_file(output, image, get(c, 16i), true)
  if dump then
    dump_code(c)
  end
  if mode = "build" then
    print: "Built ", output, " (macOS ARM64, ", get(c, 16i), " bytes)", \nl
  else
    launch(output, first_arg)
  end
end

driver()
