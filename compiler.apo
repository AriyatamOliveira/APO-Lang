# APO 2.1.5 self-hosted compiler. All pointers here refer to compiler-owned arenas.
# This file deliberately uses low-level memory; user programs keep checked buffers.
fn nil(): pointer
  unsafe
    return pointer(0i)
  end
end
fn at(p: pointer, bytes: int): pointer
  unsafe
    return offset(p, bytes)
  end
end
fn get(p: pointer, index: int): int
  unsafe
    return peek64(offset(p, index * 8i))
  end
end
fn put(p: pointer, index: int, value: int): void
  unsafe
    poke64(offset(p, index * 8i), value)
  end
end
fn getp(p: pointer, index: int): pointer
  unsafe
    return pointer(get(p, index))
  end
end
fn putp(p: pointer, index: int, value: pointer): void
  unsafe
    put(p, index, address_int(value))
  end
end
fn raw(bytes: int): pointer
  b = alloc(bytes)
  unsafe
    return address(b)
  end
end
fn getb(p: pointer, bytes: int): int
  unsafe
    return int(peek8(offset(p, bytes)))
  end
end
fn setb(p: pointer, bytes: int, value: int): void
  unsafe
    poke8(offset(p, bytes), value)
  end
end
fn gets(p: pointer, index: int): string
  unsafe
    return string_at(getp(p, index), get(p, index + 1i))
  end
end
fn puts(p: pointer, index: int, value: string): void
  unsafe
    putp(p, index, address(value))
  end
  put(p, index + 1i, int(len(value)))
end
fn rawtext(p: pointer, length: int): string
  unsafe
    return string_at(p, length)
  end
end
fn write_fd(fd: int, text: string): void
  done = 0i
  n = int(len(text))
  unsafe
    p = address(text)
    while done < n do
      r = syscall(4i, fd, offset(p, done), n - done, 0i, 0i, 0i)
      if r = -4i then
        continue
      end
      if r <= 0i then
        exit 74i
      end
      done = done + r
    end
  end
end
fn strint(value: int): string
  b = alloc(32i)
  pos = 31i
  negative = value < 0i
  v = value
  if v > 0i then
    v = -v
  end
  while true do
    digit = -(v % 10i)
    b[pos] = 48i + digit
    pos = pos - 1i
    v = v / 10i
    if v = 0i then
      break
    end
  end
  if negative then
    b[pos] = 45i
    pos = pos - 1i
  end
  unsafe
    return view(b, pos + 1i, 31i - pos)
  end
end
fn die(message: string, status: int): void
  write_fd(2i, "apo: ")
  write_fd(2i, message)
  write_fd(2i, "\n")
  exit status
end
fn need(ok: bool, message: string): void
  if not ok then
    die(message, 70i)
  end
end
fn concat(a: string, b: string): string
  n = int(len(a))
  m = int(len(b))
  if n + m > 16777216i then
    die("combined text exceeds 16 MiB", 65i)
  end
  dest = alloc(n + m + 1i)
  copy(dest, 0i, a, 0i, n)
  copy(dest, n, b, 0i, m)
  unsafe
    return view(dest, 0i, n + m)
  end
end
fn cstring(text: string): buffer
  n = int(len(text))
  if n > 4095i then
    die("path exceeds 4095 bytes", 74i)
  end
  i = 0i
  while i < n do
    if byte_at(text, i) = 0i then
      die("NUL bytes are not permitted in paths", 74i)
    end
    i = i + 1i
  end
  b = alloc(n + 1i)
  copy(b, 0i, text, 0i, n)
  return b
end
fn read_source(path: string): string
  pathbuf = cstring(path)
  unsafe
    fd = syscall(5i, address(pathbuf), 0i, 0i, 0i, 0i, 0i)
    free(pathbuf)
    if fd < 0i then
      write_fd(2i, concat(path, ": "))
      die("cannot open source", 66i)
    end
    b = alloc(8388609i)
    n = 0i
    while n < 8388609i do
      amount = syscall(3i, fd, offset(address(b), n), 8388609i - n, 0i, 0i, 0i)
      if amount = -4i then
        continue
      end
      if amount < 0i then
        syscall(6i, fd, 0i, 0i, 0i, 0i, 0i)
        die("cannot read source", 74i)
      end
      if amount = 0i then
        break
      end
      n = n + amount
    end
    syscall(6i, fd, 0i, 0i, 0i, 0i, 0i)
    if n > 8388608i then
      die("source limit is 8 MiB", 65i)
    end
    begin = 0i
    if n >= 3i and int(b[0i]) = 239i and int(b[1i]) = 187i and int(b[2i]) = 191i then
      begin = 3i
    end
    compact = alloc(n - begin + 1i)
    copy(compact, 0i, b, begin, n - begin)
    free(b)
    return view(compact, 0i, n - begin)
  end
end
fn starts(text: string, prefix: string): bool
  n = int(len(prefix))
  if int(len(text)) < n then
    return false
  end
  return slice(text, 0i, n) = prefix
end
fn ends(text: string, suffix: string): bool
  n = int(len(suffix))
  m = int(len(text))
  if m < n then
    return false
  end
  return slice(text, m - n, n) = suffix
end
fn apo_suffix(text: string): bool
  n = int(len(text))
  if n < 4i then
    return false
  end
  return byte_at(text, n - 4i) = 46i and bor(byte_at(text, n - 3i), 32i) = 97i and bor(byte_at(text, n - 2i), 32i) = 112i and bor(byte_at(text, n - 1i), 32i) = 111i
end
fn parent_dirs(path: string): void
  n = int(len(path))
  i = 1i
  while i < n do
    if byte_at(path, i) = 47i then
      name = cstring(slice(path, 0i, i))
      unsafe
        result = syscall(136i, address(name), 493i, 0i, 0i, 0i, 0i)
        if result < 0i and result != -17i then
          die("cannot create output directory", 74i)
        end
      end
      free(name)
    end
    i = i + 1i
  end
end
fn save_file(path: string, data: pointer, length: int, executable: bool): void
  parent_dirs(path)
  unsafe
    pid = syscall(20i, 0i, 0i, 0i, 0i, 0i, 0i)
    temp = concat(path, concat(".apo-tmp-", strint(pid)))
    tempbuf = cstring(temp)
    finalbuf = cstring(path)
    # O_WRONLY | O_CREAT | O_EXCL: never follow or truncate a pre-existing temp.
    fd = syscall(5i, address(tempbuf), 2561i, 384i, 0i, 0i, 0i)
    if fd < 0i then
      die("cannot create temporary output (check permissions or stale .apo-tmp file)", 74i)
    end
    written = 0i
    while written < length do
      r = syscall(4i, fd, offset(data, written), length - written, 0i, 0i, 0i)
      if r = -4i then
        continue
      end
      if r <= 0i then
        syscall(6i, fd, 0i, 0i, 0i, 0i, 0i)
        syscall(10i, address(tempbuf), 0i, 0i, 0i, 0i, 0i)
        die("writing output failed", 74i)
      end
      written = written + r
    end
    mode = 420i
    if executable then
      mode = 493i
    end
    r = syscall(124i, fd, mode, 0i, 0i, 0i, 0i)
    closed = syscall(6i, fd, 0i, 0i, 0i, 0i, 0i)
    if r < 0i or closed < 0i then
      syscall(10i, address(tempbuf), 0i, 0i, 0i, 0i, 0i)
      die("closing output failed", 74i)
    end
    if syscall(128i, address(tempbuf), address(finalbuf), 0i, 0i, 0i, 0i) < 0i then
      syscall(10i, address(tempbuf), 0i, 0i, 0i, 0i, 0i)
      die("cannot replace output", 74i)
    end
    free(tempbuf)
    free(finalbuf)
  end
end
# Parser/generator arenas use [base, capacity, used] at fields 0..2.
fn arena(context: pointer, bytes: int): pointer
  size = band(bytes + 15i, -16i)
  used = get(context, 2i)
  if size < 0i or used > get(context, 1i) - size then
    die("compiler arena exhausted (source is too complex)", 65i)
  end
  put(context, 2i, used + size)
  return at(getp(context, 0i), used)
end
fn new_arena(size: int, context_bytes: int): pointer
  c = raw(context_bytes)
  putp(c, 0i, raw(size))
  put(c, 1i, size)
  return c
end
fn fail(p: pointer, token: pointer, message: string): void
  filename = gets(p, 19i)
  if getp(token, 7i) != nil() then
    filename = gets(getp(token, 7i), 0i)
  end
  write_fd(2i, filename)
  write_fd(2i, ":")
  write_fd(2i, strint(get(token, 3i)))
  write_fd(2i, ":")
  write_fd(2i, strint(get(token, 4i)))
  write_fd(2i, ": ")
  write_fd(2i, message)
  write_fd(2i, "\n")
  exit 65i
end
# Lists have an O(1) append header [head,tail,count]; nodes [value,next].
fn list_add(p: pointer, list: pointer, value: pointer): pointer
  head = list
  if head = nil() then
    head = arena(p, 32i)
  end
  item = arena(p, 16i)
  putp(item, 0i, value)
  if getp(head, 0i) = nil() then
    putp(head, 0i, item)
  else
    putp(getp(head, 1i), 1i, item)
  end
  putp(head, 1i, item)
  put(head, 2i, get(head, 2i) + 1i)
  return head
end
fn list_get(list: pointer, index: int): pointer
  need(list != nil(), "internal list index")
  need(index >= 0i and index < get(list, 2i), "internal list index")
  it = getp(list, 0i)
  i = 0i
  while i < index do
    it = getp(it, 1i)
    i = i + 1i
  end
  return getp(it, 0i)
end
fn minint(a: int, b: int): int
  if a < b then
    return a
  end
  return b
end
fn maxint(a: int, b: int): int
  if a > b then
    return a
  end
  return b
end
# Token layout: kind,text pointer,text length,line,column,begin,end,reserved.
fn isdigit(c: int): bool
  return c >= 48i and c <= 57i
end
fn isletter(c: int): bool
  return (c >= 65i and c <= 90i) or (c >= 97i and c <= 122i) or c = 95i
end
fn isident(c: int): bool
  return isletter(c) or isdigit(c)
end
fn hexval(c: int): int
  if isdigit(c) then
    return c - 48i
  end
  if c >= 65i and c <= 70i then
    return c - 55i
  end
  if c >= 97i and c <= 102i then
    return c - 87i
  end
  return -1i
end
fn source_byte(s: string, index: int): int
  if index < 0i or index >= int(len(s)) then
    return -1i
  end
  return byte_at(s, index)
end
fn keyword(s: string): int
  if s = "task" then
    return 57i
  end
  if s = "elif" then
    return 54i
  end
  if s = "println" then
    return 55i
  end
  if s = "set" then
    return 56i
  end
  if s = "let" then
    return 44i
  end
  if s = "const" then
    return 45i
  end
  if s = "print" then
    return 24i
  end
  if s = "if" then
    return 25i
  end
  if s = "then" then
    return 26i
  end
  if s = "else" then
    return 27i
  end
  if s = "end" then
    return 28i
  end
  if s = "for" then
    return 29i
  end
  if s = "in" then
    return 30i
  end
  if s = "while" then
    return 31i
  end
  if s = "do" then
    return 32i
  end
  if s = "exit" then
    return 33i
  end
  if s = "true" then
    return 34i
  end
  if s = "false" then
    return 35i
  end
  if s = "and" then
    return 36i
  end
  if s = "or" then
    return 37i
  end
  if s = "not" then
    return 38i
  end
  if s = "fn" then
    return 39i
  end
  if s = "return" then
    return 40i
  end
  if s = "unsafe" then
    return 41i
  end
  if s = "break" then
    return 42i
  end
  if s = "continue" then
    return 43i
  end
  return 2i
end
fn token_add(p: pointer, kind: int, text: string, line: int, column: int, begin: int, finish: int): pointer
  count = get(p, 4i)
  if count >= 262144i then
    die("source exceeds 262144-token limit", 65i)
  end
  t = at(getp(p, 3i), count * 64i)
  put(t, 0i, kind)
  puts(t, 1i, text)
  put(t, 3i, line)
  put(t, 4i, column)
  put(t, 5i, begin)
  put(t, 6i, finish)
  putp(t, 7i, getp(p, 25i))
  put(p, 4i, count + 1i)
  return t
end
fn lex_error(p: pointer, line: int, column: int, message: string): void
  t = arena(p, 64i)
  putp(t, 7i, getp(p, 25i))
  put(t, 3i, line)
  put(t, 4i, column)
  fail(p, t, message)
end
fn decode_string(p: pointer, s: string, line: int, column: int): string
  n = int(len(s))
  dest = arena(p, n + 1i)
  i = 0i
  out = 0i
  while i < n do
    c = byte_at(s, i)
    i = i + 1i
    if c = 92i then
      if i >= n then
        lex_error(p, line, column, "incomplete escape")
      end
      esc = byte_at(s, i)
      i = i + 1i
      if esc = 110i then
        c = 10i
      else
        if esc = 114i then
          c = 13i
        else
          if esc = 116i then
            c = 9i
          else
            if esc = 101i then
              c = 27i
            else
              if esc = 48i then
                c = 0i
              else
                if esc = 34i or esc = 92i then
                  c = esc
                else
                  lex_error(p, line, column, "unknown string escape")
                end
              end
            end
          end
        end
      end
    end
    setb(dest, out, c)
    out = out + 1i
  end
  return rawtext(dest, out)
end
fn lex(p: pointer, source: string): void
  putp(p, 3i, raw(16777216i))
  n = int(len(source))
  i = 0i
  line = 1i
  column = 1i
  delimiters = alloc(256i)
  nesting = 0i
  while i < n do
    c = byte_at(source, i)
    if c = 32i or c = 9i or c = 11i or c = 12i then
      i = i + 1i
      column = column + 1i
      continue
    end
    if c = 35i and column = 1i and i + 11i <= n and slice(source, i, 11i) = "#@apo-file:" then
      j = i + 11i
      requested_line = 0i
      while isdigit(source_byte(source, j)) do
        if requested_line > 10000000i then
          lex_error(p, line, column, "source map line is too large")
        end
        requested_line = requested_line * 10i + source_byte(source, j) - 48i
        j = j + 1i
      end
      if source_byte(source, j) != 58i or requested_line < 1i then
        lex_error(p, line, column, "invalid source marker")
      end
      j = j + 1i
      start = j
      while j < n and source_byte(source, j) != 10i and source_byte(source, j) != 13i do
        j = j + 1i
      end
      file_info = arena(p, 16i)
      puts(file_info, 0i, slice(source, start, j - start))
      putp(p, 25i, file_info)
      line = requested_line - 1i
    end
    if c = 35i or (c = 47i and source_byte(source, i + 1i) = 47i) then
      while i < n and source_byte(source, i) != 10i and source_byte(source, i) != 13i do
        i = i + 1i
        column = column + 1i
      end
      continue
    end
    begin = i
    col = column
    if c = 10i or c = 13i then
      i = i + 1i
      if c = 13i and source_byte(source, i) = 10i then
        i = i + 1i
      end
      if nesting = 0i then
        token_add(p, 1i, "newline", line, col, begin, i)
      end
      line = line + 1i
      column = 1i
      continue
    end
    if isletter(c) then
      i = i + 1i
      while isident(source_byte(source, i)) do
        i = i + 1i
      end
      text = slice(source, begin, i - begin)
      token_add(p, keyword(text), text, line, col, begin, i)
      column = column + i - begin
      continue
    end
    if isdigit(c) then
      kind = 3i
      if c = 48i and (source_byte(source, i + 1i) = 120i or source_byte(source, i + 1i) = 88i) then
        kind = 17i
        i = i + 2i
        digits = i
        while hexval(source_byte(source, i)) >= 0i do
          i = i + 1i
        end
        if i = digits then
          lex_error(p, line, col, "hex literal requires digits")
        end
      else
        while isdigit(source_byte(source, i)) do
          i = i + 1i
        end
        dotted = false
        if source_byte(source, i) = 46i then
          dotted = true
          i = i + 1i
          if not isdigit(source_byte(source, i)) then
            lex_error(p, line, col, "decimal point must be followed by digits")
          end
          while isdigit(source_byte(source, i)) do
            i = i + 1i
          end
        end
        if source_byte(source, i) = 102i then
          kind = 46i
          i = i + 1i
        end
        if kind != 46i and not dotted and source_byte(source, i) = 105i then
          kind = 17i
          i = i + 1i
        end
      end
      if isident(source_byte(source, i)) then
        lex_error(p, line, col, "invalid numeric suffix; exponent notation is not supported")
      end
      token_add(p, kind, slice(source, begin, i - begin), line, col, begin, i)
      column = column + i - begin
      continue
    end
    if c = 34i then
      i = i + 1i
      start = i
      closed = false
      while i < n do
        ch = byte_at(source, i)
        if ch = 10i or ch = 13i then
          lex_error(p, line, col, "use \\n instead of a raw newline inside a string")
        end
        if ch = 34i then
          closed = true
          break
        end
        if ch = 92i then
          i = i + 1i
          if i >= n or source_byte(source, i) = 10i or source_byte(source, i) = 13i then
            lex_error(p, line, col, "incomplete string escape")
          end
        end
        i = i + 1i
      end
      if not closed then
        lex_error(p, line, col, "unterminated string")
      end
      text = decode_string(p, slice(source, start, i - start), line, col)
      i = i + 1i
      token_add(p, 4i, text, line, col, begin, i)
      column = column + i - begin
      continue
    end
    if c = 92i then
      if source_byte(source, i + 1i) != 110i or source_byte(source, i + 2i) != 108i or isident(source_byte(source, i + 3i)) then
        lex_error(p, line, col, "outside strings only \\nl is supported")
      end
      i = i + 3i
      token_add(p, 5i, "\n", line, col, begin, i)
      column = column + 3i
      continue
    end
    i = i + 1i
    kind = -1i
    if c = 40i then
      kind = 6i
    end
    if c = 41i then
      kind = 7i
    end
    if c = 91i then
      kind = 8i
    end
    if c = 93i then
      kind = 9i
    end
    if c = 44i then
      kind = 10i
    end
    if c = 58i then
      kind = 11i
    end
    if c = 43i then
      kind = 12i
    end
    if c = 45i then
      kind = 13i
    end
    if c = 42i then
      kind = 14i
    end
    if c = 47i then
      kind = 15i
    end
    if c = 37i then
      kind = 16i
    end
    if c = 61i then
      kind = 18i
      if source_byte(source, i) = 61i then
        kind = 53i
        i = i + 1i
      end
    end
    if c = 33i and source_byte(source, i) = 61i then
      kind = 19i
      i = i + 1i
    end
    if c = 60i then
      kind = 20i
      if source_byte(source, i) = 61i then
        kind = 21i
        i = i + 1i
      end
    end
    if c = 62i then
      kind = 22i
      if source_byte(source, i) = 61i then
        kind = 23i
        i = i + 1i
      end
    end
    if kind >= 12i and kind <= 16i and source_byte(source, i) = 61i then
      kind = kind + 35i
      i = i + 1i
    end
    if kind < 0i then
      lex_error(p, line, col, "unexpected source character")
    end
    if kind = 6i or kind = 8i then
      if nesting >= 256i then
        lex_error(p, line, col, "delimiter nesting exceeds 256")
      end
      delimiters[nesting] = kind
      nesting = nesting + 1i
    end
    if kind = 7i or kind = 9i then
      if nesting = 0i or int(delimiters[nesting - 1i]) + 1i != kind then
        lex_error(p, line, col, "mismatched closing delimiter")
      end
      nesting = nesting - 1i
    end
    token_add(p, kind, slice(source, begin, i - begin), line, col, begin, i)
    column = column + i - begin
  end
  if nesting != 0i then
    lex_error(p, line, column, "unclosed parenthesis or bracket")
  end
  free(delimiters)
  token_add(p, 0i, "end of file", line, column, n, n)
end
fn peek(p: pointer): pointer
  pos = get(p, 5i)
  need(pos >= 0i and pos < get(p, 4i), "internal token index")
  return at(getp(p, 3i), pos * 64i)
end
fn kind(p: pointer): int
  return get(peek(p), 0i)
end
fn take(p: pointer): pointer
  t = peek(p)
  if get(t, 0i) != 0i then
    put(p, 5i, get(p, 5i) + 1i)
  end
  return t
end
fn accept(p: pointer, code: int): bool
  if kind(p) != code then
    return false
  end
  take(p)
  return true
end
fn expect(p: pointer, code: int, message: string): pointer
  if kind(p) != code then
    fail(p, peek(p), message)
  end
  return take(p)
end
fn skip_lines(p: pointer): void
  while accept(p, 1i) do
  end
end
fn finish_line(p: pointer): void
  if not accept(p, 1i) and kind(p) != 0i then
    fail(p, peek(p), "expected a newline after the statement")
  end
end
# Signature table: return, effect (- ordinary; ! unsafe; t timer), argument classes.
fn builtin_spec(name: string): string
  if name = "float32_bits" then
    return "I-F"
  end
  if name = "float32_from_bits" then
    return "F-I"
  end
  if name = "atomic_load" then
    return "I-BI"
  end
  if name = "atomic_store" then
    return "V-BII"
  end
  if name = "atomic_add" then
    return "I-BII"
  end
  if name = "_parallel" then
    return "V!PBIIPP"
  end
  if name = "dlopen" then
    return "P!PI"
  end
  if name = "dlsym" then
    return "P!PP"
  end
  if name = "ccall" then
    return "I!*"
  end
  if name = "ccallp" then
    return "P!*"
  end
  if name = "ccallf" or name = "ccallf1" or name = "ccallf2" or name = "ccallf3" then
    return "F!*"
  end
  if name = "ccallv" then
    return "V!*"
  end
  if name = "argc" then
    return "I-"
