use "../../lib/native.apo"
lib = native_library("/usr/lib/libSystem.B.dylib")
sqrt_fn = native_symbol(lib, "sqrt")
pow_fn = native_symbol(lib, "pow")
ldexp_fn = native_symbol(lib, "ldexp")
unsafe
  assert(ccallf(sqrt_fn, 9.0f) = 3.0f)
  assert(ccallf(pow_fn, 2.0f, 5.0f) = 32.0f)
  assert(ccallf(ldexp_fn, 0.125f, 3i) = 1.0f)
end
