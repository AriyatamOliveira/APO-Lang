b = alloc(257i)
fill(b, 7i)
fill32_range(b, 1i, 8i, 0xdeadbeef)
assert(load32(b, 1i) = 3735928559 and b[0i] = 7 and b[9i] = 7)
fill64_range(b, 3i, 16i, -1i)
assert(load64(b, 3i) = -1i and load64(b, 11i) = -1i and b[19i] = 7)
fill_range(b, 257i, 0i, 255i)
fill_range(b, 250i, 7i, 255i)
assert(b[249i] = 7 and b[256i] = 255)
free(b)
