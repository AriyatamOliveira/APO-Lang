# APO 1.5 CPU renderer. All geometry, lighting, projection, and depth tests run here.
# No stored frames, GPU API, native graphics library, or external renderer.
fn pi(): float
  unsafe
    return float_from_bits(0x400921fb54442d18)
  end
end
fn sin(x: float): float
  tau = pi() * float(2)
  a = x - floor((x + pi()) / tau) * tau
  term = a
  result = a
  k = 1i
  while k <= 10i do
    term = -term * a * a / float((2i * k) * (2i * k + 1i))
    result = result + term
    k = k + 1i
  end
  return result
end
fn cos(x: float): float
  return sin(x + pi() / float(2))
end
fn fmin(a: float, b: float): float
  if a < b then
    return a
  end
  return b
end
fn fmax(a: float, b: float): float
  if a > b then
    return a
  end
  return b
end
fn canvas(width: int, height: int, aspect: float): buffer
  assert(width >= 16i and height >= 16i and width <= 800i and height <= 600i)
  assert(aspect > float(0))
  depth_offset = band(64i + width * height * 3i + 7i, -8i)
  image = alloc(depth_offset + width * height * 8i)
  store64(image, 0, width)
  store64(image, 8, height)
  storefloat(image, 16, aspect)
  store64(image, 24, depth_offset)
  return image
end
fn clear(image: buffer): void
  width = load64(image, 0)
  height = load64(image, 8)
  zoff = load64(image, 24)
  y = 0i
  while y < height do
    x = 0i
    while x < width do
      index = y * width + x
      # Subtle background gradient; the object is calculated separately.
      store8(image, 64i + index * 3i, 11i + y * 8i / height)
      store8(image, 65i + index * 3i, 16i + y * 10i / height)
      store8(image, 66i + index * 3i, 27i + y * 14i / height)
      storefloat(image, zoff + index * 8i, float(0))
      x = x + 1i
    end
    y = y + 1i
  end
end
fn vertex(image: buffer, vertices: buffer, i: int, x: float, y: float, z: float): void
  width = float(load64(image, 0))
  height = float(load64(image, 8))
  camera_z = z + float(6)
  focal = width * float(0.9)
  p = i * 48i
  storefloat(vertices, p, x)
  storefloat(vertices, p + 8i, y)
  storefloat(vertices, p + 16i, camera_z)
  assert(camera_z > float(0.1))
  storefloat(vertices, p + 24i, width / float(2) + x * focal / camera_z)
  storefloat(vertices, p + 32i, height * float(0.46) - y * focal * loadfloat(image, 16) / camera_z)
  storefloat(vertices, p + 40i, float(1) / camera_z)
end
fn edge(ax: float, ay: float, bx: float, by: float, px: float, py: float): float
  return (px - ax) * (by - ay) - (py - ay) * (bx - ax)
end
fn triangle(image: buffer, vertices: buffer, ia: int, ib: int, ic: int, red: int, green: int, blue: int): void
  a = ia * 48i
  b = ib * 48i
  c = ic * 48i
  ax = loadfloat(vertices, a + 24i)
  ay = loadfloat(vertices, a + 32i)
  bx = loadfloat(vertices, b + 24i)
  by = loadfloat(vertices, b + 32i)
  cx = loadfloat(vertices, c + 24i)
  cy = loadfloat(vertices, c + 32i)
  area = edge(ax, ay, bx, by, cx, cy)
  if abs(area) < float(0.000001) then
    return
  end
  ux = loadfloat(vertices, b) - loadfloat(vertices, a)
  uy = loadfloat(vertices, b + 8i) - loadfloat(vertices, a + 8i)
  uz = loadfloat(vertices, b + 16i) - loadfloat(vertices, a + 16i)
  vx = loadfloat(vertices, c) - loadfloat(vertices, a)
  vy = loadfloat(vertices, c + 8i) - loadfloat(vertices, a + 8i)
  vz = loadfloat(vertices, c + 16i) - loadfloat(vertices, a + 16i)
  nx = uy * vz - uz * vy
  ny = uz * vx - ux * vz
  nz = ux * vy - uy * vx
  length = sqrt(nx * nx + ny * ny + nz * nz)
  if length = float(0) then
    return
  end
  # Two-sided Lambert lighting. Cube winding does not determine visibility.
  light = abs(nx * float(0.4) + ny * float(0.8) - nz * float(0.6)) / (length * sqrt(float(1.16)))
  shade = float(0.24) + light * float(0.76)
  r = trunc(float(red) * shade)
  g = trunc(float(green) * shade)
  bl = trunc(float(blue) * shade)
  width = load64(image, 0)
  height = load64(image, 8)
  zoff = load64(image, 24)
  x0 = trunc(fmax(float(0), floor(fmin(ax, fmin(bx, cx)))))
  x1 = trunc(fmin(float(width - 1i), ceil(fmax(ax, fmax(bx, cx)))))
  y0 = trunc(fmax(float(0), floor(fmin(ay, fmin(by, cy)))))
  y1 = trunc(fmin(float(height - 1i), ceil(fmax(ay, fmax(by, cy)))))
  za = loadfloat(vertices, a + 40i)
  zb = loadfloat(vertices, b + 40i)
  zc = loadfloat(vertices, c + 40i)
  y = y0
  while y <= y1 do
    x = x0
    while x <= x1 do
      px = float(x) + float(0.5)
      py = float(y) + float(0.5)
      w0 = edge(bx, by, cx, cy, px, py) / area
      w1 = edge(cx, cy, ax, ay, px, py) / area
      w2 = float(1) - w0 - w1
      if w0 >= float(0) and w1 >= float(0) and w2 >= float(0) then
        inverse_z = w0 * za + w1 * zb + w2 * zc
        index = y * width + x
        if inverse_z > loadfloat(image, zoff + index * 8i) then
          storefloat(image, zoff + index * 8i, inverse_z)
          store8(image, 64i + index * 3i, r)
          store8(image, 65i + index * 3i, g)
          store8(image, 66i + index * 3i, bl)
        end
      end
      x = x + 1i
    end
    y = y + 1i
  end
end
fn face(image: buffer, vertices: buffer, a: int, b: int, c: int, d: int, r: int, g: int, bl: int): void
  triangle(image, vertices, a, b, c, r, g, bl)
  triangle(image, vertices, a, c, d, r, g, bl)
end
fn draw_cube(image: buffer, vertices: buffer, angle: float, reverse_order: bool): void
  sy = sin(angle)
  cy = cos(angle)
  sx = sin(angle * float(0.67))
  cx = cos(angle * float(0.67))
  i = 0i
  while i < 8i do
    x = float(band(i, 1i) * 2i - 1i)
    y = float(band(shr(i, 1i), 1i) * 2i - 1i)
    z = float(band(shr(i, 2i), 1i) * 2i - 1i)
    xx = x * cy + z * sy
    zz = -x * sy + z * cy
    yy = y * cx - zz * sx
    zzz = y * sx + zz * cx
    vertex(image, vertices, i, xx, yy, zzz)
    i = i + 1i
  end
  i = 0i
  while i < 6i do
    f = i
    if reverse_order then
      f = 5i - i
    end
    if f = 0i then
      face(image, vertices, 0i, 1i, 3i, 2i, 80i, 174i, 245i)
    end
    if f = 1i then
      face(image, vertices, 4i, 6i, 7i, 5i, 249i, 165i, 62i)
    end
    if f = 2i then
      face(image, vertices, 0i, 2i, 6i, 4i, 66i, 211i, 180i)
    end
    if f = 3i then
      face(image, vertices, 1i, 5i, 7i, 3i, 248i, 98i, 113i)
    end
    if f = 4i then
      face(image, vertices, 2i, 3i, 7i, 6i, 255i, 215i, 116i)
    end
    if f = 5i then
      face(image, vertices, 0i, 4i, 5i, 1i, 168i, 116i, 244i)
    end
    i = i + 1i
  end
end
fn draw_floor(image: buffer, vertices: buffer): void
  z = -3i
  while z < 5i do
    x = -5i
    while x < 5i do
      vertex(image, vertices, 0i, float(x), float(-1.85), float(z))
      vertex(image, vertices, 1i, float(x + 1i), float(-1.85), float(z))
      vertex(image, vertices, 2i, float(x + 1i), float(-1.85), float(z + 1i))
      vertex(image, vertices, 3i, float(x), float(-1.85), float(z + 1i))
      value = 47i
      if band(x + z, 1i) = 0i then
        value = 75i
      end
      face(image, vertices, 0i, 1i, 2i, 3i, value, value + 8i, value + 18i)
      x = x + 1i
    end
    z = z + 1i
  end
end

a=canvas(80i,60i,float(1))
b=canvas(80i,60i,float(1))
v=alloc(384)
theta=0i
while theta<8i do
  clear(a)
  clear(b)
  angle=float(theta)/float(7)
  draw_floor(a,v)
  draw_cube(a,v,angle,false)
  draw_cube(b,v,angle,true)
  draw_floor(b,v)
  index=0i
  while index<80i*60i*3i do
    assert(a[64i+index]=b[64i+index])
    index=index+1i
  end
  theta=theta+1i
end
clear(a)
vertex(a,v,0i,float(0),float(0),float(0))
triangle(a,v,0i,0i,0i,255i,255i,255i)
assert(loadfloat(a,load64(a,24))=float(0))
free(v)
free(a)
free(b)
print: "rasterizer: 8 angles, order-independent depth, degenerate triangle OK"
