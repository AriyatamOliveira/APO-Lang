use "../../lib/memory.apo"
b = alloc(31i)
fill(b, 7)
fill32_range(b, 1i, 8i, 0xdeadbeef)
assert(load32(b, 1i) = 3735928559)
assert(b[0i] = 7 and b[9i] = 7)
fill64_range(b, 3i, 16i, -1i)
assert(load64(b, 3i) = -1i and load64(b, 11i) = -1i)
assert(b[19i] = 7)
fill_range(b, 31i, 0i, 255i)
c = resize(b, 40i)
assert(c[39i] = 0 and c[0i] = 7)
free(c)
a = arena_new(1024i)
p = arena_take(a, 17i, 32i)
assert(p % 32i = 0i)
m = arena_mark(a)
q = arena_take(a, 3i, 64i)
assert(q % 64i = 0i and q >= p + 17i)
arena_reset(a, m)
assert(arena_take(a, 3i, 64i) = q)
free(a)
print: "Memory OK", \nl

