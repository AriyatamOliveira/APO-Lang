use "../../lib/frame.apo"
assert(frame_deadline(0, 60) == 0.016667)
assert(frame_deadline(1.234567, 30) == 1.267901)
assert(frame_deadline(0, 60) < 0.017)
start = clock()
frame_pace(start, 60)
assert(clock() >= start + 0.016667)
sleep(0.03)
frame_pace(start, 60)
print: "Deadline and late-frame tests passed", \nl
